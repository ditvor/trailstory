{# Base template for builder pages (landing, build, generating once they
   migrate). Loads the Letter design system CSS and the tri-lingual
   header. Privacy + the legacy generating template still extend
   base.html.j2 — they'll move over in phase 4. #}
<!DOCTYPE html>
<html
  lang="{{ active_lang | default('en') }}"
  data-lang="{{ active_lang | default('en') }}"
  x-data="builderShell()"
  x-init="init()"
>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=5">
  <meta name="color-scheme" content="light">
  <title>{% block title %}Trailstory · Builder{% endblock %}</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect x='1' y='1' width='30' height='30' rx='7' fill='%23F5F1E7' stroke='%232B2926' stroke-width='1.5'/><path d='M5 23 L11 13 L15 17 L21 8 L27 23' fill='none' stroke='%232B2926' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'/></svg>">

  <link rel="stylesheet" href="/static/builder.css">

  {# Alpine for the tri-lingual toggle, drop-zone previews, word counter.
     HTMX is loaded so the chip-edit OOB swaps in phase 2 work without a
     second toolchain. #}
  <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <script src="https://unpkg.com/htmx.org@2.0.4"></script>

  <script>
    // The Alpine root for every builder page. Persists the active
    // language to localStorage and writes it back to <html data-lang>
    // so the CSS visibility rules in builder.css swap on every span
    // tagged lang-en / lang-ru / lang-de.
    function builderShell() {
      return {
        lang: '{{ active_lang | default('en') }}',
        init() {
          const stored = localStorage.getItem('trailstory.lang');
          if (stored && ['en', 'ru', 'de'].includes(stored)) {
            this.lang = stored;
          }
          this.apply();
        },
        setLang(code) {
          if (!['en', 'ru', 'de'].includes(code)) return;
          this.lang = code;
          localStorage.setItem('trailstory.lang', code);
          this.apply();
        },
        apply() {
          document.documentElement.setAttribute('lang', this.lang);
          document.documentElement.setAttribute('data-lang', this.lang);
        },
      };
    }
  </script>

  {% block head_extra %}{% endblock %}
</head>
<body>
  <header class="bp-header">
    <a href="/" class="bp-logo" aria-label="Trailstory">
      <span class="bp-logo-word">Trailstory</span>
      {# Role tag next to the wordmark — quiet mono, signals the
         compose surface (vs the published memory page). #}
      <span class="bp-logo-tag" aria-hidden="true">
        <span class="lang-en">compose</span>
        <span class="lang-ru">письмо</span>
        <span class="lang-de">verfassen</span>
      </span>
    </a>
    <nav class="bp-langnav" aria-label="Language">
      {% for code, label in [('en', 'EN'), ('ru', 'RU'), ('de', 'DE')] %}
      <button
        type="button"
        class="bp-lang-btn"
        :aria-pressed="lang === '{{ code }}'"
        @click="setLang('{{ code }}')"
      >{{ label }}</button>
      {% endfor %}
    </nav>
  </header>

  <main class="bp-main">
    {% block content %}{% endblock %}
  </main>

  <footer class="bp-footer">
    {# Serif-italic sign-off — frames the whole compose surface as a
       letter: something written and sent, not generated. #}
    <span class="bp-footer-sig" aria-hidden="true">
      <span class="lang-en">— with love, from the trail</span>
      <span class="lang-ru">— с любовью, с тропы</span>
      <span class="lang-de">— mit Liebe, vom Weg</span>
    </span>
    <div>
      <span class="lang-en">TRAILSTORY · FOR FAMILY ABROAD</span>
      <span class="lang-ru">TRAILSTORY · ДЛЯ СЕМЬИ ВДАЛИ</span>
      <span class="lang-de">TRAILSTORY · FÜR FAMILIE FERNAB</span>
    </div>
    <div>
      <a href="/privacy" target="_blank" rel="noopener noreferrer">
        <span class="lang-en">PRIVACY ↗</span>
        <span class="lang-ru">ПРИВАТНОСТЬ ↗</span>
        <span class="lang-de">DATENSCHUTZ ↗</span>
      </a>
    </div>
  </footer>
</body>
</html>

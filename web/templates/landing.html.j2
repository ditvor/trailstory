{% extends "builder_base.html.j2" %}

{% block title %}Trailstory · Build a memory{% endblock %}

{% block content %}
{# The docket + hero live inside the form's Alpine root so the docket can
   react to the parsed track. The <form> itself is nested below. #}
<div x-data="builderForm()">

  {# docket — the sharing frame, stated up front: who it's for, where
     it's from. Decorative; stores nothing. FROM fills in with the
     detected place once a track is parsed. #}
  <div class="bp-docket">
    <div class="bp-docket-item">
      <span class="bp-docket-k">
        <span class="lang-en">To</span>
        <span class="lang-ru">Кому</span>
        <span class="lang-de">An</span>
      </span>
      <span class="bp-docket-v">
        <span class="lang-en">family in Russia, friends elsewhere</span>
        <span class="lang-ru">семье в России, друзьям повсюду</span>
        <span class="lang-de">Familie in Russland, Freunde anderswo</span>
      </span>
    </div>
    <div class="bp-docket-item">
      <span class="bp-docket-k">
        <span class="lang-en">From</span>
        <span class="lang-ru">Откуда</span>
        <span class="lang-de">Von</span>
      </span>
      <span class="bp-docket-v">
        <span x-show="track && track.location_name" x-cloak x-text="track && track.location_name"></span>
        <span x-show="!track || !track.location_name">
          <span class="lang-en">the trail</span>
          <span class="lang-ru">с тропы</span>
          <span class="lang-de">vom Weg</span>
        </span>
      </span>
    </div>
  </div>

  {# hero #}
  <section class="bp-hero">
    <h1 class="bp-h1">
      <span class="lang-en">Keep the day.<br><em>Send it home.</em></span>
      <span class="lang-ru">Сохрани день.<br><em>Отправь домой.</em></span>
      <span class="lang-de">Bewahre den Tag.<br><em>Schick ihn nach Hause.</em></span>
    </h1>
    <p class="bp-dek">
      <span class="lang-en">Your photos, a few sentences about how it felt, and the walk underneath. Choose how to tell it — and send a letter home in one click.</span>
      <span class="lang-ru">Твои фотографии, пара предложений о том, как это было, и прогулка в основе. Выбери, как рассказать, — и отправь письмо домой в один клик.</span>
      <span class="lang-de">Deine Fotos, ein paar Sätze, wie es war, und der Weg darunter. Wähle, wie du es erzählst — und schick in einem Klick einen Brief nach Hause.</span>
    </p>
    <div class="bp-hero-meta">
      <span class="bp-draft-badge">
        <span class="lang-en">Draft</span>
        <span class="lang-ru">Черновик</span>
        <span class="lang-de">Entwurf</span>
      </span>
      <span class="bp-dot" aria-hidden="true">·</span>
      <span class="bp-saved">
        <span class="bp-saved-dot" aria-hidden="true"></span>
        <span class="lang-en">nothing leaves your device yet</span>
        <span class="lang-ru">пока ничего не уходит с устройства</span>
        <span class="lang-de">noch verlässt nichts dein Gerät</span>
      </span>
    </div>
  </section>

  <form
    action="/generate"
    method="post"
    enctype="multipart/form-data"
    @submit="submitting = true"
  >
    {# 01 — The day, in photos: dropzone OR client-side preview grid #}
    <section class="bp-section">
      <div class="bp-section-head">
        <span class="bp-section-num">01</span>
        <h2 class="bp-section-title">
          <span class="lang-en">The day, in photos</span>
          <span class="lang-ru">День в фотографиях</span>
          <span class="lang-de">Der Tag, in Fotos</span>
        </h2>
        <span class="bp-section-hint" x-text="(photos.length || 0) + ' / 60'">0 / 60</span>
      </div>
      <div class="bp-section-body">
        <label class="bp-dropzone" x-show="!photos.length" x-cloak>
          <input
            type="file"
            name="photos"
            accept="image/*,.heic,.heif"
            multiple
            required
            class="bp-dropzone-input"
            @change="onPhotos($event)"
          >
          <div class="bp-dropzone-icon" aria-hidden="true">
            <svg width="40" height="40" viewBox="0 0 40 40">
              <rect x="4" y="10" width="32" height="22" stroke="currentColor" stroke-width="1.8" fill="none"/>
              <circle cx="14" cy="20" r="3" stroke="currentColor" stroke-width="1.6" fill="none"/>
              <path d="M4 28 L 14 20 L 22 26 L 32 16 L 36 20" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="bp-dropzone-title">
            <span class="lang-en">Drop your photos here</span>
            <span class="lang-ru">Перетащи сюда фотографии</span>
            <span class="lang-de">Lege deine Fotos hier ab</span>
          </div>
          <div class="bp-dropzone-hint">
            <span class="lang-en">JPG / HEIC · up to 60</span>
            <span class="lang-ru">JPG / HEIC · до 60</span>
            <span class="lang-de">JPG / HEIC · bis zu 60</span>
          </div>
        </label>

        <div x-show="photos.length" x-cloak>
          <div class="bp-photogrid">
            <template x-for="(p, i) in photos" :key="i">
              <div class="bp-phototile">
                <img :src="p.url" alt="" loading="lazy">
                <div class="bp-phototile-num" x-text="String(i + 1).padStart(2, '0')"></div>
              </div>
            </template>
          </div>
          <p class="bp-mini">
            <span class="lang-en"><span x-text="photos.length"></span> photo<span x-show="photos.length !== 1">s</span> · Claude picks 6–8 and captions them in your voice.</span>
            <span class="lang-ru"><span x-text="photos.length"></span> фото · Claude выберет 6–8 и подпишет твоим голосом.</span>
            <span class="lang-de"><span x-text="photos.length"></span> Foto<span x-show="photos.length !== 1">s</span> · Claude wählt 6–8 und betitelt sie in deiner Stimme.</span>
            <button
              type="button"
              @click="resetPhotos()"
              style="border:0;background:transparent;cursor:pointer;font:inherit;color:var(--c-accent);text-decoration:underline;margin-left:8px;"
            >
              <span class="lang-en">Replace</span>
              <span class="lang-ru">Заменить</span>
              <span class="lang-de">Ersetzen</span>
            </button>
          </p>
          {# Re-selection input (used after a reset re-opens the dropzone;
             kept here so the ref survives the populated state). #}
          <input
            x-ref="photoInput"
            type="file"
            name="photos"
            accept="image/*,.heic,.heif"
            multiple
            class="bp-dropzone-input"
            @change="onPhotos($event)"
          >
        </div>
      </div>
    </section>

    {# 02 — How it felt: textarea + AUTO-EXTRACTED chips #}
    <section class="bp-section">
      <div class="bp-section-head">
        <span class="bp-section-num">02</span>
        <h2 class="bp-section-title">
          <span class="lang-en">How it felt</span>
          <span class="lang-ru">Как это было</span>
          <span class="lang-de">Wie es sich anfühlte</span>
        </h2>
        <span class="bp-section-hint">
          <span class="lang-en">DE · RU · EN — doesn't matter</span>
          <span class="lang-ru">DE · RU · EN — любой</span>
          <span class="lang-de">DE · RU · EN — egal</span>
        </span>
      </div>
      <div class="bp-section-body">
        <textarea
          class="bp-textarea"
          name="description"
          required
          minlength="1"
          maxlength="1000"
          rows="8"
          @input="onDesc($event)"
          x-bind:placeholder="lang === 'ru' ? 'Мы начали с городской площади сразу после полудня…' : (lang === 'de' ? 'Wir starteten am Marktplatz kurz nach Mittag…' : 'We started at the town square just after noon…')"
        ></textarea>
        <div class="bp-textarea-foot">
          <span>
            <span x-text="descWords"></span>
            <span class="lang-en"> words</span>
            <span class="lang-ru"> слов</span>
            <span class="lang-de"> Wörter</span>
          </span>
          <span x-show="descLen > 0" x-cloak>
            <span class="lang-en">auto-saved</span>
            <span class="lang-ru">сохранено</span>
            <span class="lang-de">gespeichert</span>
          </span>
        </div>

        {# AUTO-EXTRACTED chips. Visible once at least one source has
           filled a value. The location chip is editable inline; the
           date chip is read-only display. #}
        <div class="bp-chips" x-show="hasChips()" x-cloak>
          <span class="bp-chip-label">
            <span class="lang-en">From your track &amp; photos</span>
            <span class="lang-ru">Из трека и фото</span>
            <span class="lang-de">Aus Track &amp; Fotos</span>
          </span>

          {# Location chip — editable. Hidden form input below carries the
             final value into the POST. #}
          <template x-if="locationValue || track">
            <span
              class="bp-chip"
              x-show="!editingLocation"
              @click="startEditLocation()"
              tabindex="0"
              @keydown.enter.prevent="startEditLocation()"
              role="button"
            >
              <span class="bp-chip-icon" aria-hidden="true">📍</span>
              <span
                class="bp-chip-val"
                x-text="locationValue || (lang === 'ru' ? 'Без места' : (lang === 'de' ? 'Kein Ort' : 'No location'))"
              ></span>
              <span class="bp-chip-src">
                ·
                <span x-text="locationSourceLabel()"></span>
              </span>
              <span class="bp-chip-edit" aria-hidden="true">✎</span>
            </span>
          </template>
          <span class="bp-chip bp-chip--editing" x-show="editingLocation" x-cloak>
            <span class="bp-chip-icon" aria-hidden="true">📍</span>
            <input
              x-ref="locationInput"
              class="bp-chip-input"
              type="text"
              x-model="locationDraft"
              maxlength="120"
              @keydown.enter.prevent="saveLocation()"
              @keydown.escape.prevent="cancelLocation()"
            >
            <button type="button" class="bp-chip-act" @click="saveLocation()" aria-label="Save">✓</button>
            <button type="button" class="bp-chip-act bp-chip-act--cancel" @click="cancelLocation()" aria-label="Cancel">×</button>
          </span>
          <input type="hidden" name="location" :value="locationValue">

          {# Date chip — read-only #}
          <template x-if="dateValue">
            <span class="bp-chip bp-chip--static">
              <span class="bp-chip-icon" aria-hidden="true">◷</span>
              <span class="bp-chip-val" x-text="formatDate(dateValue)"></span>
              <span class="bp-chip-src">
                ·
                <span x-text="dateSourceLabel()"></span>
              </span>
            </span>
          </template>
        </div>
      </div>
    </section>

    {# 03 — From the walk: GPX dropzone OR populated track-loaded card #}
    <section class="bp-section">
      <div class="bp-section-head">
        <span class="bp-section-num">03</span>
        <h2 class="bp-section-title">
          <span class="lang-en">From the walk</span>
          <span class="lang-ru">С прогулки</span>
          <span class="lang-de">Von der Wanderung</span>
        </h2>
        <span class="bp-section-hint">
          <span class="lang-en">GPX · auto-read from your track</span>
          <span class="lang-ru">GPX · читается из трека</span>
          <span class="lang-de">GPX · automatisch aus dem Track</span>
        </span>
      </div>
      <div class="bp-section-body">
        {# Dropzone — visible until a GPX has been parsed by /preview/gpx #}
        <label class="bp-dropzone" x-show="!track" x-cloak>
          <input
            type="file"
            name="gpx"
            accept=".gpx,application/gpx+xml"
            required
            class="bp-dropzone-input"
            x-ref="gpxInput"
            @change="onGpx($event)"
          >
          <div class="bp-dropzone-icon" aria-hidden="true">
            <svg width="40" height="40" viewBox="0 0 40 40">
              <path d="M6 32 Q 14 14, 22 22 T 34 8" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/>
              <circle cx="6" cy="32" r="2.6" fill="currentColor"/>
              <circle cx="34" cy="8" r="2.6" fill="none" stroke="currentColor" stroke-width="1.6"/>
              <circle cx="22" cy="22" r="1.8" fill="none" stroke="currentColor" stroke-width="1.4"/>
            </svg>
          </div>
          <div class="bp-dropzone-title">
            <span class="lang-en">Drop your GPX track here</span>
            <span class="lang-ru">Перетащи сюда файл GPX</span>
            <span class="lang-de">Lege deinen GPX-Track hier ab</span>
          </div>
          <div class="bp-dropzone-hint">
            <span class="lang-en">distance, ascent &amp; time, read automatically</span>
            <span class="lang-ru">дистанция, подъём и время — автоматически</span>
            <span class="lang-de">Strecke, Anstieg &amp; Zeit — automatisch</span>
          </div>
          <p
            class="bp-dropzone-filename"
            x-show="gpxName && !track"
            x-cloak
            x-text="trackError || ('Parsing ' + gpxName + '…')"
          ></p>
        </label>

        {# Populated track-loaded card — visible once /preview/gpx returns #}
        <div class="bp-track-card" x-show="track" x-cloak>
          <div class="bp-track-row">
            <div class="bp-track-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 40 40">
                <path d="M6 32 Q 14 14, 22 22 T 34 8" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/>
                <circle cx="6" cy="32" r="2.6" fill="currentColor"/>
                <circle cx="34" cy="8" r="2.6" fill="none" stroke="currentColor" stroke-width="1.6"/>
              </svg>
            </div>
            <div class="bp-track-filemeta">
              <div class="bp-track-filename" x-text="track && track.filename"></div>
              <div class="bp-track-parsed">
                <span x-text="track && track.n_points"></span>
                <span class="lang-en"> points · parsed</span>
                <span class="lang-ru"> точек · разобрано</span>
                <span class="lang-de"> Punkte · gelesen</span>
              </div>
            </div>
            <button
              type="button"
              class="bp-track-replace"
              @click="resetTrack()"
            >
              <span class="lang-en">Replace</span>
              <span class="lang-ru">Заменить</span>
              <span class="lang-de">Ersetzen</span>
            </button>
          </div>
          <hr class="bp-track-divider">
          <div class="bp-track-summary">
            <div class="bp-track-stats">
              <div class="bp-stat">
                <div class="bp-stat-k">
                  <span class="lang-en">DISTANCE</span>
                  <span class="lang-ru">ДИСТАНЦИЯ</span>
                  <span class="lang-de">STRECKE</span>
                </div>
                <div class="bp-stat-v" x-text="track ? track.distance_km.toFixed(1) + ' km' : ''"></div>
              </div>
              <div class="bp-stat">
                <div class="bp-stat-k">
                  <span class="lang-en">ASCENT</span>
                  <span class="lang-ru">ПОДЪЁМ</span>
                  <span class="lang-de">ANSTIEG</span>
                </div>
                <div class="bp-stat-v" x-text="track ? '+' + Math.round(track.elevation_gain_m) + ' m' : ''"></div>
              </div>
              <div class="bp-stat">
                <div class="bp-stat-k">
                  <span class="lang-en">TIME</span>
                  <span class="lang-ru">ВРЕМЯ</span>
                  <span class="lang-de">ZEIT</span>
                </div>
                <div class="bp-stat-v" x-text="track ? formatDuration(track.duration_min) : ''"></div>
              </div>
              <div class="bp-stat">
                <div class="bp-stat-k">
                  <span class="lang-en">DETECTED</span>
                  <span class="lang-ru">МЕСТО</span>
                  <span class="lang-de">ERKANNT</span>
                </div>
                <div class="bp-stat-v" x-text="(track && track.location_name) || '—'"></div>
              </div>
            </div>
            <div class="bp-track-mini" aria-hidden="true" x-show="track && track.track_d" x-cloak>
              <svg viewBox="0 0 220 110" preserveAspectRatio="xMidYMid meet">
                <path
                  :d="(track && track.track_d) || ''"
                  fill="none"
                  stroke="var(--c-ink-2)"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                {# x-show (not a <template x-if>): Alpine can't cloneNode a
                   <template> inside an <svg> (no .content fragment), so we
                   toggle a plain <g> and keep cx/cy resolving to a valid
                   number even before a track loads. #}
                <g x-show="track && track.endpoints && track.endpoints.length >= 2">
                  <circle :cx="(track && track.endpoints) ? track.endpoints[0][0].toFixed(2) : 0" :cy="(track && track.endpoints) ? track.endpoints[0][1].toFixed(2) : 0" r="3" fill="var(--c-accent)"/>
                  <circle :cx="(track && track.endpoints) ? track.endpoints[1][0].toFixed(2) : 0" :cy="(track && track.endpoints) ? track.endpoints[1][1].toFixed(2) : 0" r="3" fill="var(--c-paper)" stroke="var(--c-accent)" stroke-width="1.2"/>
                </g>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </section>

    {# 04 — THE CENTERPIECE: choose how to tell it. 5 cards; only The
       Letter is buildable in v0. Selecting one warms the page chrome
       toward that style (the chameleon, applyChameleon below). #}
    <section class="bp-section">
      <div class="bp-section-head">
        <span class="bp-section-num">04</span>
        <h2 class="bp-section-title">
          <span class="lang-en">Choose how to tell it</span>
          <span class="lang-ru">Выбери, как рассказать</span>
          <span class="lang-de">Wähle, wie du es erzählst</span>
        </h2>
      </div>
      <p class="bp-section-sub">
        <span class="lang-en">The same day, five ways to remember it. Pick one — the page takes on its colors.</span>
        <span class="lang-ru">Один день — пять способов его запомнить. Выбери один, и страница примет его цвета.</span>
        <span class="lang-de">Derselbe Tag, fünf Arten, sich zu erinnern. Wähle eine — die Seite nimmt ihre Farben an.</span>
      </p>
      <div class="bp-section-body">
        <div class="bp-stylegrid">
          {% for s in styles %}
          <label class="bp-stylecard{% if s.coming_soon %} bp-stylecard--soon{% endif %}">
            <input
              type="radio"
              name="style"
              value="{{ s.value }}"
              {% if s.coming_soon %}disabled aria-disabled="true"{% else %}@change="applyChameleon('{{ s.value }}')"{% endif %}
              {% if s.value == default_style %}checked{% endif %}
            >
            <div class="bp-stylecard-thumb">
              {% include "style_thumbs/" + s.value + ".html.j2" ignore missing %}
            </div>
            <div class="bp-stylecard-body">
              <div class="bp-stylecard-head">
                <div class="bp-stylecard-name">
                  <span class="lang-en">{{ s.name_en }}</span>
                  <span class="lang-ru">{{ s.name_ru }}</span>
                  <span class="lang-de">{{ s.name_de }}</span>
                </div>
                {% if s.coming_soon %}
                <span class="bp-stylecard-tag">
                  <span class="lang-en">SOON</span>
                  <span class="lang-ru">СКОРО</span>
                  <span class="lang-de">BALD</span>
                </span>
                {% endif %}
              </div>
              <div class="bp-stylecard-sub">
                <span class="lang-en">{{ s.sub_en }}</span>
                <span class="lang-ru">{{ s.sub_ru }}</span>
                <span class="lang-de">{{ s.sub_de }}</span>
              </div>
              <p class="bp-stylecard-desc">
                <span class="lang-en">{{ s.desc_en }}</span>
                <span class="lang-ru">{{ s.desc_ru }}</span>
                <span class="lang-de">{{ s.desc_de }}</span>
              </p>
            </div>
          </label>
          {% endfor %}
        </div>
      </div>
    </section>

    {# Send it home #}
    <section class="bp-generate">
      <div class="bp-stamp" aria-hidden="true">
        <div class="bp-stamp-inner">
          <svg width="34" height="34" viewBox="0 0 40 40">
            <path d="M6 32 Q 14 14, 22 22 T 34 8" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/>
            <circle cx="6" cy="32" r="2.4" fill="currentColor"/>
            <circle cx="34" cy="8" r="2.4" fill="none" stroke="currentColor" stroke-width="1.6"/>
          </svg>
          <span class="bp-stamp-cap">PAR AVION</span>
        </div>
      </div>
      <div class="bp-send-main">
        <button type="submit" class="bp-cta" :disabled="submitting">
          <span x-show="!submitting">
            <span class="lang-en">Send it home</span>
            <span class="lang-ru">Отправить домой</span>
            <span class="lang-de">Nach Hause schicken</span>
          </span>
          <span x-show="submitting" x-cloak>
            <span class="lang-en">Writing it now…</span>
            <span class="lang-ru">Пишем…</span>
            <span class="lang-de">Wir schreiben…</span>
          </span>
          <span class="bp-cta-arrow" aria-hidden="true">→</span>
        </button>
        <div class="bp-generate-meta">
          <span>
            <span class="lang-en">~ 30 seconds</span>
            <span class="lang-ru">≈ 30 секунд</span>
            <span class="lang-de">~ 30 Sekunden</span>
          </span>
          <span class="bp-dot" aria-hidden="true">·</span>
          <span>
            <span class="lang-en">we don't keep your photos</span>
            <span class="lang-ru">мы не храним ваши фото</span>
            <span class="lang-de">wir speichern deine Fotos nicht</span>
          </span>
          <span class="bp-dot" aria-hidden="true">·</span>
          <span>
            <a href="/privacy" target="_blank" rel="noopener noreferrer">
              <span class="lang-en">How we handle your photos ↗</span>
              <span class="lang-ru">Как мы обращаемся с фото ↗</span>
              <span class="lang-de">Umgang mit deinen Fotos ↗</span>
            </a>
          </span>
        </div>
      </div>
    </section>
  </form>
</div>

<script>
  // Alpine root for the single-page builder form. Lives at form-scope.
  // Drives:
  //   - GPX track preview (track-loaded card + AUTO-EXTRACTED chips)
  //   - photo preview grid + EXIF date extraction for the date chip
  //   - inline-editable location chip
  //   - word count + auto-saved indicator
  //   - the chameleon: warm the page chrome toward the chosen style
  //   - submit-busy state
  function builderForm() {
    return {
      // GPX
      gpxName: '',
      track: null,            // {filename, n_points, distance_km, ...}
      trackError: '',         // populated on preview failure
      // Photos
      photos: [],             // [{name, url}]
      photoDate: null,        // ISO date from photo EXIF
      // Description
      descLen: 0,
      descText: '',
      // Location chip (inline-edit)
      editingLocation: false,
      locationDraft: '',
      locationValue: '',
      locationSource: '',     // 'track' | 'user' | ''
      // Submit busy
      submitting: false,

      // Bridge to <html data-lang>; built by builderShell() in
      // builder_base.html.j2.
      get lang() {
        return document.documentElement.getAttribute('data-lang') || 'en';
      },

      // Word count for the "How it felt" footer.
      get descWords() {
        const t = this.descText.trim();
        return t ? t.split(/\s+/).length : 0;
      },

      // The current date the chip displays. Photo EXIF wins over GPX
      // waypoint time when both are present (the design's promise).
      get dateValue() {
        return this.photoDate || (this.track && this.track.hike_date) || null;
      },

      // ──────────────────────────────────────────────────────────────
      // Chameleon — warm the chrome toward the chosen style's palette.
      // Mirrors the editorial/per-style colours; only buildable styles
      // wire @change to this, so in v0 it resolves to The Letter. The
      // map is ready for the moment more styles unlock.
      // ──────────────────────────────────────────────────────────────
      applyChameleon(styleId) {
        const P = {
          editorial: {
            paper: 'oklch(0.972 0.008 80)', paper2: 'oklch(0.945 0.012 80)',
            ink: 'oklch(0.18 0.01 80)', ink2: 'oklch(0.34 0.01 80)', ink3: 'oklch(0.55 0.01 80)',
            accent: 'oklch(0.30 0.01 80)', accentSoft: 'oklch(0.18 0.01 80 / 0.07)',
            rule: 'oklch(0.18 0.01 80 / 0.16)', hairline: 'oklch(0.18 0.01 80 / 0.08)',
          },
          zine: {
            paper: 'oklch(0.948 0.022 86)', paper2: 'oklch(0.92 0.028 84)',
            ink: 'oklch(0.14 0.01 70)', ink2: 'oklch(0.32 0.03 60)', ink3: 'oklch(0.5 0.025 60)',
            accent: 'oklch(0.62 0.19 35)', accentSoft: 'oklch(0.62 0.19 35 / 0.16)',
            rule: 'oklch(0.14 0.01 70 / 0.18)', hairline: 'oklch(0.14 0.01 70 / 0.10)',
          },
          sunday: {
            paper: 'oklch(0.965 0.038 95)', paper2: 'oklch(0.94 0.05 92)',
            ink: 'oklch(0.22 0.04 55)', ink2: 'oklch(0.42 0.04 50)', ink3: 'oklch(0.58 0.035 55)',
            accent: 'oklch(0.71 0.17 30)', accentSoft: 'oklch(0.71 0.17 30 / 0.15)',
            rule: 'oklch(0.22 0.04 55 / 0.18)', hairline: 'oklch(0.22 0.04 55 / 0.09)',
          },
          postcard: {
            paper: 'oklch(0.948 0.024 80)', paper2: 'oklch(0.975 0.02 82)',
            ink: 'oklch(0.20 0.02 50)', ink2: 'oklch(0.42 0.03 50)', ink3: 'oklch(0.56 0.03 55)',
            accent: 'oklch(0.58 0.20 28)', accentSoft: 'oklch(0.58 0.20 28 / 0.14)',
            rule: 'oklch(0.20 0.02 50 / 0.18)', hairline: 'oklch(0.20 0.02 50 / 0.09)',
          },
          album: {
            paper: 'oklch(0.94 0.025 88)', paper2: 'oklch(0.91 0.03 86)',
            ink: 'oklch(0.20 0.01 60)', ink2: 'oklch(0.40 0.02 60)', ink3: 'oklch(0.56 0.02 60)',
            accent: 'oklch(0.32 0.10 260)', accentSoft: 'oklch(0.32 0.10 260 / 0.12)',
            rule: 'oklch(0.20 0.01 60 / 0.18)', hairline: 'oklch(0.20 0.01 60 / 0.09)',
          },
        };
        const p = P[styleId] || P.editorial;
        const root = document.documentElement.style;
        root.setProperty('--c-paper', p.paper);
        root.setProperty('--c-paper-2', p.paper2);
        root.setProperty('--c-ink', p.ink);
        root.setProperty('--c-ink-2', p.ink2);
        root.setProperty('--c-ink-3', p.ink3);
        root.setProperty('--c-accent', p.accent);
        root.setProperty('--c-accent-soft', p.accentSoft);
        root.setProperty('--c-rule', p.rule);
        root.setProperty('--c-hairline', p.hairline);
      },

      // ──────────────────────────────────────────────────────────────
      // GPX preview
      // ──────────────────────────────────────────────────────────────
      async onGpx(e) {
        const file = e.target.files && e.target.files[0];
        if (!file) { this.gpxName = ''; return; }
        this.gpxName = file.name;
        this.trackError = '';
        const fd = new FormData();
        fd.append('gpx', file);
        try {
          const r = await fetch('/preview/gpx', { method: 'POST', body: fd });
          if (!r.ok) {
            const j = await r.json().catch(() => ({}));
            this.trackError = j.detail || 'Could not parse GPX';
            return;
          }
          this.track = await r.json();
          // Seed the location chip if no user override is set.
          if (!this.locationValue && this.track && this.track.location_name) {
            this.locationValue = this.track.location_name;
            this.locationSource = 'track';
          }
        } catch (err) {
          this.trackError = 'Network error';
        }
      },

      resetTrack() {
        this.track = null;
        this.gpxName = '';
        this.trackError = '';
        // Reset the file input so re-uploading the same file triggers
        // the change handler again.
        if (this.$refs.gpxInput) this.$refs.gpxInput.value = '';
        // Don't clear locationValue if the user has edited it manually.
        if (this.locationSource === 'track') {
          this.locationValue = '';
          this.locationSource = '';
        }
      },

      // ──────────────────────────────────────────────────────────────
      // Photo preview — client-side thumbnails + first-photo EXIF date
      // ──────────────────────────────────────────────────────────────
      async onPhotos(e) {
        const files = Array.from(e.target.files || []);
        this.photos = files.map(function (f) {
          return { name: f.name, url: URL.createObjectURL(f) };
        });
        this.photoDate = null;
        if (!files.length) return;
        // Send the first photo (smallest payload) to /preview/photo for
        // EXIF date extraction. The bytes are never persisted.
        const fd = new FormData();
        fd.append('photo', files[0]);
        try {
          const r = await fetch('/preview/photo', { method: 'POST', body: fd });
          if (!r.ok) return;
          const j = await r.json();
          if (j.hike_date) this.photoDate = j.hike_date;
        } catch (_) { /* best-effort */ }
      },

      resetPhotos() {
        this.photos.forEach(function (p) {
          try { URL.revokeObjectURL(p.url); } catch (_) {}
        });
        this.photos = [];
        this.photoDate = null;
        if (this.$refs.photoInput) this.$refs.photoInput.value = '';
      },

      // ──────────────────────────────────────────────────────────────
      // Description word count
      // ──────────────────────────────────────────────────────────────
      onDesc(e) {
        this.descText = e.target.value;
        this.descLen = e.target.value.length;
      },

      // ──────────────────────────────────────────────────────────────
      // Location chip inline edit
      // ──────────────────────────────────────────────────────────────
      startEditLocation() {
        this.editingLocation = true;
        this.locationDraft = this.locationValue;
        this.$nextTick(() => this.$refs.locationInput && this.$refs.locationInput.focus());
      },
      saveLocation() {
        this.locationValue = this.locationDraft.trim();
        this.locationSource = 'user';
        this.editingLocation = false;
      },
      cancelLocation() {
        this.editingLocation = false;
        this.locationDraft = this.locationValue;
      },

      // ──────────────────────────────────────────────────────────────
      // Chip helpers
      // ──────────────────────────────────────────────────────────────
      hasChips() {
        return !!(this.locationValue || this.track || this.dateValue);
      },
      locationSourceLabel() {
        const code = this.lang;
        if (this.locationSource === 'user') {
          return code === 'ru' ? 'вы ввели' : (code === 'de' ? 'manuell' : 'you typed');
        }
        // Default: GPX track name.
        return code === 'ru' ? 'из трека' : (code === 'de' ? 'aus Track' : 'from track');
      },
      dateSourceLabel() {
        const code = this.lang;
        if (this.photoDate) {
          return code === 'ru' ? 'из EXIF фото' : (code === 'de' ? 'aus Foto-EXIF' : 'from photo EXIF');
        }
        return code === 'ru' ? 'из трека' : (code === 'de' ? 'aus Track' : 'from track');
      },

      // ──────────────────────────────────────────────────────────────
      // Formatters
      // ──────────────────────────────────────────────────────────────
      formatDuration(mins) {
        const h = Math.floor(mins / 60);
        const m = mins % 60;
        if (h <= 0) return m + 'm';
        return h + 'h ' + String(m).padStart(2, '0') + 'm';
      },
      formatDate(iso) {
        const d = new Date(iso);
        if (isNaN(d.getTime())) return iso;
        const code = this.lang;
        const months = {
          en: ['January','February','March','April','May','June','July','August','September','October','November','December'],
          ru: ['января','февраля','марта','апреля','мая','июня','июля','августа','сентября','октября','ноября','декабря'],
          de: ['Januar','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'],
        };
        const m = months[code] || months.en;
        return code === 'en'
          ? `${m[d.getMonth()]} ${d.getDate()}, ${d.getFullYear()}`
          : `${d.getDate()} ${m[d.getMonth()]} ${d.getFullYear()}`;
      },
    };
  }
</script>
{% endblock %}

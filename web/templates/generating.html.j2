{% extends "base.html.j2" %}

{% block title %}Trailstory — writing your memory…{% endblock %}

{% block content %}
<section
  class="mt-2"
  x-data="{
    phase: 'writing',
    chunks: '',
    error: '',
    redirect: '',
    init() {
      const es = new EventSource('/generate/{{ slug }}/stream');
      es.addEventListener('chunk', (e) => {
        try { this.chunks += JSON.parse(e.data).text || ''; } catch (_) {}
      });
      es.addEventListener('status', (e) => {
        try { this.phase = JSON.parse(e.data).phase || this.phase; } catch (_) {}
      });
      es.addEventListener('done', (e) => {
        try { this.redirect = JSON.parse(e.data).redirect || ''; } catch (_) {}
        es.close();
        if (this.redirect) window.location = this.redirect;
      });
      es.addEventListener('error', (e) => {
        try {
          const detail = e.data ? JSON.parse(e.data) : null;
          this.error = (detail && detail.error) || 'connection lost';
        } catch (_) {
          this.error = 'connection lost';
        }
        es.close();
      });
    },
  }"
  data-slug="{{ slug }}"
  data-style="{{ style }}"
>
  <h1 class="text-2xl sm:text-3xl font-bold leading-tight tracking-tight">
    <span x-show="phase === 'writing'">Writing your memory…</span>
    <span x-show="phase === 'regenerating'" x-cloak>One more pass — the model needed a tidier draft…</span>
    <span x-show="phase === 'rendering'" x-cloak>Rendering the page…</span>
  </h1>
  <p class="mt-3 text-sm text-[color:var(--subtle)] leading-relaxed">
    The page will open as soon as the narrative is ready. You can keep this
    tab in the foreground; closing it doesn't lose the work — the page is
    cached for {{ retention_minutes if retention_minutes else 30 }} minutes
    at <code>/memory/{{ slug }}</code>.
  </p>

  <!-- live writing area -->
  <div
    role="status"
    aria-live="polite"
    class="mt-6 min-h-[12rem] rounded-lg border border-[color:var(--rule)] bg-white p-4 text-sm leading-relaxed whitespace-pre-wrap font-mono"
    x-text="chunks || 'Starting up…'"
  ></div>

  <p
    class="mt-4 text-xs text-[color:var(--subtle)]"
    x-show="phase === 'regenerating'"
    x-cloak
  >
    The first draft didn't parse cleanly. We're trying once more before
    giving up — usually fixes itself.
  </p>

  <!-- error state -->
  <div
    x-show="error"
    x-cloak
    class="mt-6 rounded-lg border border-red-300 bg-red-50 p-4 text-sm text-red-800"
    role="alert"
  >
    <p class="font-semibold">We couldn't generate the memory.</p>
    <p class="mt-1" x-text="error"></p>
    <p class="mt-3">
      <a href="/" class="underline">← Try again from the form</a>
    </p>
  </div>

  <!-- privacy reminder -->
  <p class="mt-8 text-xs text-center text-[color:var(--subtle)]">
    Your raw upload has already been deleted. Only the privacy-stripped
    JPEGs and the rendered page remain.
    <a class="underline" href="/privacy" target="_blank" rel="noopener noreferrer">Privacy details.</a>
  </p>
</section>
{% endblock %}

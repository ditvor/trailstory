{# Style thumbnail: indie zine / riso, two-color, loud. Renderer not
   built yet — the card is gated as coming_soon in web/copy.py. #}
<div style="background: var(--zine-paper); height: 100%; padding: 10px 12px; overflow: hidden; position: relative;">
  <div style="font-family: var(--zine-display); font-weight: 700; font-size: 8px; letter-spacing: 0.18em; color: var(--zine-ink);">
    TRAILSTORY / FIELD NOTES
  </div>
  <div style="height: 2px; background: var(--zine-ink); margin: 3px 0 1px;"></div>
  <div style="font-family: var(--zine-display); font-weight: 900; font-size: 40px; color: var(--zine-ink); line-height: 0.82; letter-spacing: -0.03em;">BAD</div>
  <div style="font-family: var(--zine-display); font-weight: 900; font-size: 40px; -webkit-text-stroke: 1.5px var(--zine-ink); color: transparent; line-height: 0.82; letter-spacing: -0.03em; margin-left: 0.4em;">TÖLZ</div>
  <div style="position: absolute; right: 8px; bottom: 8px; width: 60px; height: 36px; background: radial-gradient(circle, var(--zine-spot) 1px, transparent 1.5px); background-size: 5px 5px;"></div>
  <div style="position: absolute; left: 12px; bottom: 8px; font-family: var(--zine-display); font-weight: 700; font-size: 8px; letter-spacing: 0.18em; color: var(--zine-spot);">ISSUE №07</div>
</div>

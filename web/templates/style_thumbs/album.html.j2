{# Style thumbnail: scrapbook / polaroid + tape feel. The renderer for
   this style does not exist yet — the card is gated as coming_soon in
   web/copy.py. #}
<div style="background: var(--album-paper); height: 100%; padding: 8px 12px; overflow: hidden; position: relative;">
  <div style="font-family: var(--mono); font-size: 7px; letter-spacing: 0.24em; color: var(--album-ink);">ALBUM · 01 OF 07</div>
  <div style="font-family: var(--serif); font-size: 26px; color: var(--album-ink); margin-top: 2px; line-height: 0.95; font-variation-settings: 'opsz' 60;">Bad Tölz</div>
  <div style="font-family: var(--serif); font-style: italic; font-size: 13px; color: var(--album-pen); transform: rotate(-1deg); display: inline-block;">kept, taped, written down</div>
  <div style="position: absolute; right: 12px; bottom: 8px; transform: rotate(4deg); width: 64px; background: var(--album-photo); padding: 3px 3px 12px; box-shadow: 0 4px 10px -4px rgba(40,30,20,0.32);">
    <div style="position: absolute; top: -4px; left: 20%; width: 26px; height: 7px; background: var(--album-tape-pink); transform: rotate(-4deg);"></div>
    <div style="width: 100%; padding-top: 100%; background: var(--album-paper-2); position: relative; overflow: hidden;">
      <div style="position: absolute; inset: 0; background-image: linear-gradient(135deg, var(--album-warm) 0%, var(--album-coral) 100%); opacity: 0.4;"></div>
    </div>
    <div style="font-family: var(--serif); font-style: italic; font-size: 8px; color: var(--album-pen); margin-top: 2px; line-height: 1;">April 19</div>
  </div>
</div>

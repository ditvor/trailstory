{# Phase-1 placeholder thumb for the editorial / Letter style. Phase 3
   replaces this with a hand-crafted CSS preview matching the design
   proposal. #}
<div style="background: var(--paper); height: 100%; padding: 12px 14px; overflow: hidden; position: relative;">
  <div style="font-family: var(--mono); font-size: 8px; letter-spacing: 0.22em; color: var(--ink-2);">A WALK · ISAR</div>
  <div style="font-family: var(--serif); font-style: italic; font-weight: 400; font-size: 22px; line-height: 0.95; color: var(--ink); margin-top: 6px; font-variation-settings: 'opsz' 60;">A Saturday</div>
  <div style="font-family: var(--serif); font-weight: 500; font-size: 22px; line-height: 0.95; color: var(--ink); font-variation-settings: 'opsz' 60; letter-spacing: -0.01em;">in Bad Tölz</div>
  <div style="margin-top: 8px; display: flex; gap: 8px;">
    <div style="flex: 2; font-family: var(--serif); font-size: 9px; line-height: 1.4; color: var(--ink);">
      <span style="font-weight: 600; font-size: 22px; line-height: 0.8; float: left; margin-right: 3px; margin-top: 1px;">W</span>e pulled in a little after noon. The town does the thing small towns do in spring — pretends nothing is happening.
    </div>
    <div style="flex: 1; font-family: var(--mono); font-size: 6.5px; color: var(--ink-3); letter-spacing: 0.06em; line-height: 1.6;">
      <div style="border-bottom: 1px solid var(--hairline); padding-bottom: 1px;">DIST · 8.4 km</div>
      <div style="border-bottom: 1px solid var(--hairline); padding-bottom: 1px;">↑ · 210 m</div>
      <div style="border-bottom: 1px solid var(--hairline); padding-bottom: 1px;">TIME · 3:40</div>
    </div>
  </div>
</div>

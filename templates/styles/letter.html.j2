<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=5">
<meta name="color-scheme" content="light">
<title>{{ narrative.title.en }}</title>
{# No-JS viewers (Telegram/Mail/Files previews never run scripts) must
   get a fully visible page; JS-only effects are scoped under `.js`. #}
<script>document.documentElement.classList.add('js');</script>
<style>
  /* ── fonts ─────────────────────────────────────────────────────────
     Source Serif 4 (variable: opsz 8..60, wght 300..600, italic + roman)
     stands in for Newsreader because Newsreader has no Cyrillic on
     Google Fonts and RU is a primary audience. Same opsz feel.
     Subsets are split into latin + cyrillic so the browser only
     activates the cyrillic file when it renders Cyrillic glyphs.
     All payloads base64-embedded → page works offline (ADR-001). */
  @font-face {
    font-family: 'Letter Serif';
    font-style: italic;
    font-weight: 300 600;
    font-display: swap;
    src: url(data:font/woff2;base64,{{ fonts.serif_italic_latin }}) format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Letter Serif';
    font-style: italic;
    font-weight: 300 600;
    font-display: swap;
    src: url(data:font/woff2;base64,{{ fonts.serif_italic_cyrillic }}) format('woff2');
    unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
  }
  @font-face {
    font-family: 'Letter Serif';
    font-style: normal;
    font-weight: 300 600;
    font-display: swap;
    src: url(data:font/woff2;base64,{{ fonts.serif_roman_latin }}) format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Letter Serif';
    font-style: normal;
    font-weight: 300 600;
    font-display: swap;
    src: url(data:font/woff2;base64,{{ fonts.serif_roman_cyrillic }}) format('woff2');
    unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
  }
  @font-face {
    font-family: 'Letter Mono';
    font-style: normal;
    font-weight: 400 500;
    font-display: swap;
    src: url(data:font/woff2;base64,{{ fonts.mono_latin }}) format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Letter Mono';
    font-style: normal;
    font-weight: 400 500;
    font-display: swap;
    src: url(data:font/woff2;base64,{{ fonts.mono_cyrillic }}) format('woff2');
    unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
  }

  /* ── design tokens ─────────────────────────────────────────────── */
  :root {
    --paper:    oklch(0.972 0.008 80);
    --paper-2:  oklch(0.945 0.012 80);
    --ink:      oklch(0.18 0.01 80);
    --ink-2:    oklch(0.32 0.01 80);
    --ink-3:    oklch(0.55 0.01 80);
    --rule:     oklch(0.18 0.01 80 / 0.18);
    --hairline: oklch(0.18 0.01 80 / 0.10);
    --serif: 'Letter Serif', 'Times New Roman', Georgia, serif;
    --mono:  'Letter Mono', ui-monospace, Menlo, monospace;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--serif);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  ::selection { background: var(--ink); color: var(--paper); }
  :focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }

  /* Visually hidden but still readable by screen readers and present in the
     DOM as text. Used to keep the full title text contiguous in the page
     source even though the visible title is split into italic-top + roman-bot. */
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }

  /* ── reading progress bar ──────────────────────────────────────── */
  .progress {
    position: fixed; top: 0; left: 0; height: 2px;
    width: 0%; background: var(--ink); z-index: 50;
    transition: width 120ms linear;
  }

  /* ── chapter rail (≥1280px) ────────────────────────────────────── */
  .rail { display: none; }
  @media (min-width: 1280px) {
    .rail {
      display: flex; flex-direction: column; gap: 14px;
      position: fixed; left: 36px; top: 50%;
      transform: translateY(-50%); z-index: 5;
    }
    .rail button {
      width: 20px; height: 8px; padding: 0; margin: 0;
      background: transparent; border: 0; cursor: pointer;
      display: flex; align-items: center;
    }
    .rail .tick {
      width: 14px; height: 1px; background: var(--ink); opacity: 0.35;
      transition: opacity 200ms, width 200ms, height 200ms;
    }
    .rail button[aria-current="true"] .tick {
      width: 6px; height: 6px; border-radius: 50%; opacity: 1;
    }
    .rail button:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  }

  /* ── article shell ─────────────────────────────────────────────── */
  .article {
    position: relative;
    max-width: 1100px; margin: 0 auto;
    padding: 72px 64px 96px;
  }
  @media (max-width: 1023px) { .article { padding: 56px 32px 72px; } }
  @media (max-width: 767px)  { .article { padding: 40px 24px 56px; } }

  /* ── sticky language toggle ────────────────────────────────────── */
  .lang {
    position: absolute; top: 18px; right: 64px; z-index: 20;
    display: flex; gap: 0;
    border: 1px solid var(--ink); background: var(--paper);
    font-family: var(--mono);
  }
  @media (max-width: 1023px) { .lang { right: 32px; } }
  @media (max-width: 767px)  { .lang { right: 24px; top: 12px; } }
  .lang label {
    background: var(--paper); color: var(--ink);
    border: 0; padding: 6px 10px; margin: 0;
    font: inherit; font-size: 10px;
    letter-spacing: 0.14em; text-transform: uppercase;
    cursor: pointer;
  }
  .lang label + label { border-left: 1px solid var(--ink); }
  @media (max-width: 767px) { .lang label { padding: 4px 8px; font-size: 9px; } }

  /* ── tri-lingual swap ──────────────────────────────────────────────
     Driven by three hidden radios that are the first children of
     <body>, so the toggle works with JavaScript disabled (Telegram's
     iOS preview, Mail, Quick Look). JS only adds the swap animation
     and persistence on top. */
  .lang-radio {
    position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
    border: 0; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap;
  }
  #lang-en:checked ~ * .lang label[for="lang-en"],
  #lang-ru:checked ~ * .lang label[for="lang-ru"],
  #lang-de:checked ~ * .lang label[for="lang-de"] {
    background: var(--ink); color: var(--paper);
  }
  #lang-en:focus-visible ~ * .lang label[for="lang-en"],
  #lang-ru:focus-visible ~ * .lang label[for="lang-ru"],
  #lang-de:focus-visible ~ * .lang label[for="lang-de"] {
    outline: 2px solid var(--ink); outline-offset: 2px;
  }
  #lang-en:checked ~ * .ru, #lang-en:checked ~ * .de { display: none; }
  #lang-ru:checked ~ * .en, #lang-ru:checked ~ * .de { display: none; }
  #lang-de:checked ~ * .en, #lang-de:checked ~ * .ru { display: none; }

  .swap { transition: opacity 180ms ease; }
  .swap.is-swapping { opacity: 0.4; }

  /* ── masthead ──────────────────────────────────────────────────── */
  .eyebrow {
    font-family: var(--mono); font-size: 11px; font-weight: 400;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--ink-2);
  }
  .masthead .eyebrow { margin-bottom: 28px; display: block; }
  .display {
    margin: 0; font-weight: 400;
    font-variation-settings: "opsz" 60;
    letter-spacing: -0.02em; line-height: 0.96;
    font-size: clamp(48px, 8vw, 96px);
  }
  .display .top { font-style: italic; font-weight: 300; display: block; }
  .display .bot { font-style: normal; font-weight: 500; display: block; }
  .dek {
    margin: 28px 0 0; max-width: 580px;
    font-family: var(--serif); font-weight: 400;
    font-variation-settings: "opsz" 18;
    font-size: 18px; line-height: 1.4;
    color: var(--ink-2);
  }
  .meta {
    margin-top: 22px;
    font-family: var(--mono); font-size: 11px;
    letter-spacing: 0.04em; color: var(--ink-3);
  }
  .rule { border: 0; border-top: 1px solid var(--rule); margin: 40px 0 0; }

  /* ── layout grid ───────────────────────────────────────────────── */
  .grid {
    display: grid; gap: 56px;
    grid-template-columns: 1fr 240px;
    margin-top: 48px;
  }
  @media (max-width: 1023px) {
    .grid { grid-template-columns: 1fr; gap: 0; }
  }

  /* ── prose ─────────────────────────────────────────────────────── */
  .prose {
    font-family: var(--serif); font-weight: 400;
    font-variation-settings: "opsz" 14;
    font-size: 17px; line-height: 1.55;
    color: var(--ink);
    text-wrap: pretty; hyphens: auto;
  }
  .prose p { margin: 0 0 1.1em; }
  .prose p:last-child { margin-bottom: 0; }
  @media (min-width: 600px) {
    .prose > .body > p.en:first-of-type::first-letter,
    .prose > .body > p.ru:first-of-type::first-letter,
    .prose > .body > p.de:first-of-type::first-letter {
      font-family: var(--serif);
      font-weight: 500; font-style: normal;
      font-variation-settings: "opsz" 60;
      float: left;
      font-size: 4.4em;
      line-height: 0.85;
      padding: 0.08em 0.12em 0 0;
      color: var(--ink);
    }
  }

  /* ── photo slots (rotating layout variants per index) ──────────── */
  .figure {
    margin: 28px 0;
    background: var(--paper-2);
  }
  .figure img {
    display: block; width: 100%; height: auto;
    /* Lock every figure to the same landscape rectangle (3:2 — standard
       editorial photo ratio). Portrait and landscape originals end up the
       same height; CSS crops the overflow with object-fit so a tall
       portrait does not stretch a column into a wall, and a wide
       landscape does not letterbox. Mixed-aspect photo sets render as a
       consistent grid instead of a ragged stack. */
    aspect-ratio: 3 / 2;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.02);
  }
  /* Blur-up is a JS-only enhancement: without it photos must render
     immediately (no-JS previews never fire the load handler). */
  .js .figure img { opacity: 0; transition: opacity 240ms ease; }
  .js .figure img.loaded { opacity: 1; }
  .figure-caption {
    margin-top: 8px;
    font-family: var(--mono); font-size: 10px;
    letter-spacing: 0.04em; text-transform: uppercase;
    color: var(--ink-3);
  }
  @media (min-width: 1024px) {
    /* variant a — float right, 240w */
    .figure.v-a {
      float: right; width: 240px;
      margin: 6px 0 14px 28px;
      shape-outside: margin-box;
    }
    /* variant b — full column-width block */
    .figure.v-b { clear: both; }
    /* variant c — full column-width emphasis block.
       (The original brief specified a -64px right bleed into the gutter,
       but our marginalia sidebar lives in that gutter and would be
       overlapped. Full-column width still gives a strong visual beat
       without colliding with the facts panel.) */
    .figure.v-c { clear: both; }
    /* variant d — 65% column width, left-aligned block */
    .figure.v-d { clear: both; max-width: 65%; }
    /* variant e — float left, 200w */
    .figure.v-e {
      float: left; width: 200px;
      margin: 6px 28px 14px 0;
      shape-outside: margin-box;
    }
  }

  /* ── pull quote ────────────────────────────────────────────────── */
  .quote {
    margin: 36px 0 32px;
    padding: 4px 0 4px 24px;
    border-left: 2px solid var(--ink);
    font-style: italic; font-weight: 400;
    font-variation-settings: "opsz" 24;
    font-size: 24px; line-height: 1.3;
    color: var(--ink);
  }
  /* Scroll-reveal is a JS-only enhancement (IntersectionObserver);
     without it the quote must be visible from the start. */
  .js .quote {
    opacity: 0; transform: translateY(8px);
    transition: opacity 400ms ease, transform 400ms ease;
  }
  .js .quote.seen { opacity: 1; transform: none; }

  /* ── marginalia (sidebar) ──────────────────────────────────────── */
  /* Static positioning on desktop too — sticky behaviour interacts badly
     with headless PDF capture (Puppeteer, wkhtmltopdf), and the page
     is short enough that "follows the scroll" added little anyway. */
  .margin {
    font-family: var(--mono);
    font-size: 11px; line-height: 1.7;
  }
  @media (min-width: 1024px) {
    .margin { align-self: start; }
  }
  .margin section + section { margin-top: 32px; }
  .margin h3 {
    margin: 0 0 12px;
    font-family: var(--mono); font-weight: 400;
    font-size: 11px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--ink-3);
  }
  .facts dl {
    display: grid;
    grid-template-columns: 76px 1fr;
    gap: 0 12px; margin: 0;
  }
  .facts dt, .facts dd {
    padding: 5px 0;
    border-top: 1px solid var(--hairline);
  }
  .facts dt { color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.06em; }
  .facts dd { margin: 0; color: var(--ink); }
  .facts dt:first-of-type, .facts dd:first-of-type { border-top: 0; padding-top: 0; }

  /* ── about this place (ADR-017) ────────────────────────────────── */
  /* Sits at the top of the marginalia: "where am I" is the first
     context a distant reader wants. Summary in serif (not the mono
     facts idiom) so 2-3 sentences read as prose; source link in the
     small mono register for attribution (Wikipedia is CC BY-SA). */
  .place .place-summary {
    margin: 0;
    font-family: var(--serif);
    font-variation-settings: "opsz" 14;
    font-size: 13.5px; line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty; hyphens: auto;
  }
  .place .place-source { margin: 10px 0 0; font-size: 10px; letter-spacing: 0.04em; }
  .place .place-source a {
    color: var(--ink-3); text-decoration: none;
    border-bottom: 1px solid var(--hairline);
  }
  .place .place-source a:hover { color: var(--ink); }

  .path-box {
    border: 1px solid var(--hairline);
    background: var(--paper-2);
    padding: 8px; width: 100%;
  }
  .path-box svg { display: block; width: 100%; height: auto; }
  .path-caption, .elev-caption {
    margin-top: 8px; color: var(--ink-3);
    font-size: 10px; letter-spacing: 0.04em;
  }
  .elevation { display: block; width: 100%; height: 36px; }

  /* mobile: marginalia becomes collapsible band between article and share */
  @media (max-width: 1023px) {
    .margin {
      grid-column: 1; margin-top: 40px;
      border-top: 1px solid var(--rule);
      padding-top: 24px;
    }
    .margin-toggle {
      display: flex; justify-content: space-between; align-items: center;
      width: 100%; padding: 0 0 16px;
      background: transparent; border: 0;
      font-family: var(--mono); font-size: 11px;
      letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--ink-3); cursor: pointer;
    }
    .margin-toggle .sign { font-size: 14px; color: var(--ink); }
    .margin-body { display: block; }
    .margin[data-open="false"] .margin-body { display: none; }
  }
  @media (min-width: 1024px) {
    .margin-toggle { display: none; }
  }

  /* ── share row ─────────────────────────────────────────────────── */
  .share {
    margin-top: 56px;
    padding-top: 18px;
    border-top: 1px solid var(--rule);
    display: flex; flex-wrap: wrap; gap: 8px; align-items: center;
  }
  .share-label {
    margin-right: 8px;
    font-family: var(--mono); font-size: 11px;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--ink-2);
  }
  .share button, .share a {
    display: inline-block; padding: 10px 14px; margin: 0;
    font-family: var(--mono); font-size: 11px;
    letter-spacing: 0.10em; text-transform: uppercase;
    background: var(--paper); color: var(--ink);
    border: 1px solid var(--ink); cursor: pointer;
    text-decoration: none;
    transition: background 120ms ease, color 120ms ease;
  }
  .share button:hover, .share a:hover { background: var(--ink); color: var(--paper); }
  .share button.primary, .share a.primary { background: var(--ink); color: var(--paper); }
  .share button.primary:hover, .share a.primary:hover { background: var(--ink-2); border-color: var(--ink-2); }
  .share-status {
    width: 100%;
    margin-top: 6px;
    font-family: var(--mono); font-size: 10px;
    letter-spacing: 0.04em; color: var(--ink-3);
    min-height: 1.2em;
  }
  .back-nav { margin-top: 20px; }
  .back-nav a {
    font-family: var(--mono); font-size: 11px;
    letter-spacing: 0.10em; text-transform: uppercase;
    color: var(--ink-2); text-decoration: none;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 2px;
  }
  .back-nav a:hover { color: var(--ink); border-color: var(--ink); }
  .ig-fallback {
    display: flex; flex-wrap: wrap; gap: 6px;
    width: 100%; margin-top: 6px;
  }
  .ig-fallback a {
    padding: 6px 10px; font-size: 10px;
    background: var(--paper-2); border: 1px solid var(--hairline); color: var(--ink-2);
  }
  .ig-fallback a:hover { background: var(--ink); color: var(--paper); border-color: var(--ink); }

  /* ── cheatsheet overlay ────────────────────────────────────────── */
  .cheat {
    position: fixed; bottom: 24px; right: 24px; z-index: 100;
    padding: 18px 22px; background: var(--paper); border: 1px solid var(--ink);
    font-family: var(--mono); font-size: 11px; line-height: 1.8;
    color: var(--ink); max-width: 280px;
  }
  .cheat h4 { margin: 0 0 8px; font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-3); font-weight: 400; }
  .cheat dl { display: grid; grid-template-columns: 48px 1fr; gap: 2px 12px; margin: 0; }
  .cheat dt { color: var(--ink-2); }
  .cheat dd { margin: 0; color: var(--ink); }
  .cheat[hidden] { display: none; }

  /* ── footer ────────────────────────────────────────────────────── */
  .colophon {
    margin-top: 56px; padding-top: 18px;
    border-top: 1px solid var(--hairline);
    font-family: var(--mono); font-size: 10px;
    letter-spacing: 0.04em; color: var(--ink-3);
  }

  /* ── print ─────────────────────────────────────────────────────── */
  @media print {
    .progress, .rail, .lang, .share, .back-nav, .cheat, .margin-toggle { display: none !important; }
    html, body { background: var(--paper); color: var(--ink); }
    body { font-size: 11pt; }
    .article { padding: 24pt; max-width: none; }
    .grid { grid-template-columns: 1fr; gap: 0; }
    .margin { position: static; margin-top: 24pt; page-break-inside: avoid; }
    .figure img { opacity: 1 !important; }
    body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }

</style>
</head>
<body class="style-letter">

  {# Language state lives in these radios (first children of <body> so
     the `:checked ~` CSS can reach every language span). Works without
     JavaScript; `checked` below is the default for no-JS viewers. #}
  <input type="radio" name="lang" id="lang-en" class="lang-radio" value="en" checked>
  <input type="radio" name="lang" id="lang-ru" class="lang-radio" value="ru">
  <input type="radio" name="lang" id="lang-de" class="lang-radio" value="de">

  <div class="progress" id="progress" aria-hidden="true"></div>

  <nav class="rail" id="rail" aria-label="Sections"></nav>

  <article class="article" id="article">

    <div class="lang" role="group" aria-label="Language">
      <label for="lang-en">EN</label>
      <label for="lang-ru">RU</label>
      <label for="lang-de">DE</label>
    </div>

    <header class="masthead swap">
      <span class="eyebrow">
        <span class="en">{{ narrative.milestone.en }}</span>
        <span class="ru">{{ narrative.milestone.ru }}</span>
        <span class="de">{{ narrative.milestone.de }}</span>
      </span>
      {# Split each language's title across two lines: top word italic / rest roman.
         If the title is one word, both spans get the same text — the italic top
         then collapses naturally because of the `display: block` on `.bot`. #}
      <h1 class="display">
        <span class="en">
          <span class="sr-only">{{ narrative.title.en }}</span>
          {% set words = narrative.title.en.split(' ', 1) %}
          <span class="top" aria-hidden="true">{{ words[0] }}</span>
          <span class="bot" aria-hidden="true">{{ words[1] if words|length > 1 else '' }}</span>
        </span>
        <span class="ru">
          <span class="sr-only">{{ narrative.title.ru }}</span>
          {% set words = narrative.title.ru.split(' ', 1) %}
          <span class="top" aria-hidden="true">{{ words[0] }}</span>
          <span class="bot" aria-hidden="true">{{ words[1] if words|length > 1 else '' }}</span>
        </span>
        <span class="de">
          <span class="sr-only">{{ narrative.title.de }}</span>
          {% set words = narrative.title.de.split(' ', 1) %}
          <span class="top" aria-hidden="true">{{ words[0] }}</span>
          <span class="bot" aria-hidden="true">{{ words[1] if words|length > 1 else '' }}</span>
        </span>
      </h1>
      <p class="dek">
        <span class="en">{{ narrative.subtitle.en }}</span>
        <span class="ru">{{ narrative.subtitle.ru }}</span>
        <span class="de">{{ narrative.subtitle.de }}</span>
      </p>
      {% if meta.location or meta.date %}
      {# Byline + dateline. The byline reads as a small editorial note
         clarifying provenance — that the prose is reconstructed from
         the seed text, the GPX track, and the photos — not a real-time
         diary. Conditional on at least one of location/date so the
         no-meta render stays clean. #}
      <div class="meta">
        <span class="en">Written from notes, photographs, and a recorded path.</span>
        <span class="ru">Написано по заметкам, фотографиям и записанному треку.</span>
        <span class="de">Aus Notizen, Fotos und einem aufgezeichneten Pfad geschrieben.</span>
        <span aria-hidden="true"> &middot; </span>{% if meta.location %}{{ meta.location | upper }}{% endif %}{% if meta.location and meta.date %} &middot; {% endif %}{% if meta.date %}{{ meta.date }}{% endif %}
      </div>
      {% endif %}
      <hr class="rule">
    </header>

    <div class="grid">

      <section class="prose" id="prose">
        {# Hero photo: float-right at top of prose, OUTSIDE the language
           divs so body text in any language wraps around the same single
           emission of the base64 payload. #}
        {% if photos|length > 0 %}
          <figure class="figure v-a"><img src="{{ photos[0].data_uri }}" alt="" loading="eager"></figure>
        {% endif %}

        {# Photo distribution. ADR-014 (Phase 4): paragraphs is a list
           of Paragraph, each a list of Sentence with tri-lingual text.
           Provenance stays in the data model for the quality gates but
           is not rendered — the page reads as plain prose.

           Layout: photos[0] is the hero float (emitted above). The
           remaining photos are interleaved one-per-paragraph through
           the body so the photo rhythm matches the prose rhythm; any
           overflow falls after the pull quote.

           Previous layout (2026-05) put a single mid-body photo at
           index ``n//2 - 1`` and stacked photos[2:] in a tail after
           the quote. With 6–8 selected photos that produced one photo
           in the top half and five-to-seven crowded after the bottom
           quote — pilot users read it as a photo dump. Interleaving
           keeps the page balanced. #}
        {% set extras = photos[1:] if photos|length > 1 else [] %}
        {% set inter = extras[:narrative.paragraphs | length] %}
        {% set tail = extras[narrative.paragraphs | length:] %}
        <div class="body swap">
          {% for paragraph in narrative.paragraphs %}
            <p class="en">
              {% for sentence in paragraph -%}
                {{ sentence.text.en }}{% if not loop.last %} {% endif -%}
              {% endfor %}
            </p>
            <p class="ru">
              {% for sentence in paragraph -%}
                {{ sentence.text.ru }}{% if not loop.last %} {% endif -%}
              {% endfor %}
            </p>
            <p class="de">
              {% for sentence in paragraph -%}
                {{ sentence.text.de }}{% if not loop.last %} {% endif -%}
              {% endfor %}
            </p>
            {%- if loop.index0 < inter|length %}
              {# Use full-column variants for inline interleavers — float
                 variants (v-a, v-e) interact poorly with mid-body
                 paragraph wrapping. The float idioms still anchor the
                 hero at the top and the tail at the bottom. #}
              {% set v = ['v-b', 'v-c', 'v-d', 'v-b'][loop.index0 % 4] %}
              <figure class="figure {{ v }}">
                <img src="{{ inter[loop.index0].data_uri }}" alt="" loading="lazy">
              </figure>
            {% endif %}
          {% endfor %}
        </div>

        <blockquote class="quote swap" id="quote">
          <span class="en">{{ narrative.pull_quote.en }}</span>
          <span class="ru">{{ narrative.pull_quote.ru }}</span>
          <span class="de">{{ narrative.pull_quote.de }}</span>
        </blockquote>

        {# Overflow tail: photos that did not fit in the interleaved
           slots above. Rotates through the original float / block
           variants so the bottom of the page still has visual rhythm
           when there are more photos than paragraphs. #}
        {% if tail|length > 0 %}
          {% for ph in tail %}
            {% set v = ['v-e', 'v-b', 'v-d', 'v-b'][loop.index0 % 4] %}
            <figure class="figure {{ v }}">
              <img src="{{ ph.data_uri }}" alt="" loading="lazy">
            </figure>
          {% endfor %}
        {% endif %}

        <section class="share" aria-label="Share">
          <span class="share-label">
            <span class="en">SHARE &rarr;</span>
            <span class="ru">ПОДЕЛИТЬСЯ &rarr;</span>
            <span class="de">TEILEN &rarr;</span>
          </span>
          <button id="pdfBtn" type="button" class="primary">
            <span class="en">Save as PDF</span>
            <span class="ru">Сохранить в PDF</span>
            <span class="de">Als PDF speichern</span>
          </button>
          <button id="htmlBtn" type="button">
            <span class="en">Share page (HTML file)</span>
            <span class="ru">Поделиться страницей (HTML)</span>
            <span class="de">Seite teilen (HTML-Datei)</span>
          </button>
          <button id="igBtn" type="button" data-slug="{{ meta.slug }}">
            <span class="en">Save for Instagram</span>
            <span class="ru">Сохранить для Instagram</span>
            <span class="de">Für Instagram speichern</span>
          </button>
          <p id="igStatus" class="share-status" aria-live="polite"></p>
        </section>

        {# Only meaningful while the page is served by the web builder
           (/memory/<slug>); JS unhides it there. A saved or forwarded
           copy of the file keeps it hidden — recipients have no
           builder to go back to. #}
        <nav class="back-nav" id="backNav" hidden>
          <a href="/">
            <span class="en">&larr; Back to the main page</span>
            <span class="ru">&larr; На главную</span>
            <span class="de">&larr; Zur Startseite</span>
          </a>
        </nav>

        <footer class="colophon">{{ meta.slug }}</footer>
      </section>

      <aside class="margin" data-open="true" id="margin">
        <button type="button" class="margin-toggle" id="marginToggle" aria-expanded="true">
          <span>
            <span class="en">The facts &amp; the path</span>
            <span class="ru">Факты и маршрут</span>
            <span class="de">Fakten &amp; Route</span>
          </span>
          <span class="sign" aria-hidden="true">&minus;</span>
        </button>
        <div class="margin-body">

          {# ADR-017: "about this place" block. Conditional — only present
             when the --place pass ran and resolved a PlaceContext. The
             summary is the grounded stitch (Wikipedia extract + the hiker's
             own beats); the source link is the CC BY-SA attribution. #}
          {% if place %}
          <section class="place">
            <h3>
              <span class="en">About {{ place.town }}</span>
              <span class="ru">О месте: {{ place.town }}</span>
              <span class="de">Über {{ place.town }}</span>
            </h3>
            <p class="place-summary">
              <span class="en">{{ place.summary.en }}</span>
              <span class="ru">{{ place.summary.ru }}</span>
              <span class="de">{{ place.summary.de }}</span>
            </p>
            {% if place.source_url or place.named_landmarks %}
            <p class="place-source">
              {% if place.source_url %}
              <a href="{{ place.source_url }}" target="_blank" rel="noopener noreferrer">
                <span class="en">Source: {{ place.source_title or place.town }}</span>
                <span class="ru">Источник: {{ place.source_title or place.town }}</span>
                <span class="de">Quelle: {{ place.source_title or place.town }}</span>
              </a>
              {% endif %}
              {% if place.named_landmarks %}{% if place.source_url %}<span aria-hidden="true"> · </span>{% endif %}<a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">© OpenStreetMap contributors</a>{% endif %}
            </p>
            {% endif %}
          </section>
          {% endif %}

          <section class="facts">
            <h3>
              <span class="en">The facts</span>
              <span class="ru">Факты</span>
              <span class="de">Fakten</span>
            </h3>
            <dl>
              {% if meta.location %}
              <dt><span class="en">Where</span><span class="ru">Где</span><span class="de">Wo</span></dt>
              <dd>{{ meta.location }}</dd>
              {% endif %}
              {% if meta.date %}
              <dt><span class="en">When</span><span class="ru">Когда</span><span class="de">Wann</span></dt>
              <dd>{{ meta.date }}</dd>
              {% endif %}
              <dt><span class="en">Distance</span><span class="ru">Дистанция</span><span class="de">Strecke</span></dt>
              <dd>{{ stats.distance_km }} km</dd>
              <dt><span class="en">Ascent</span><span class="ru">Набор</span><span class="de">Anstieg</span></dt>
              <dd>+{{ stats.elevation_gain_m | int }} m</dd>
              <dt><span class="en">Time</span><span class="ru">Время</span><span class="de">Zeit</span></dt>
              <dd>{{ '%dh %02dm' | format(stats.duration_min // 60, stats.duration_min % 60) }}</dd>
              <dt><span class="en">Summit</span><span class="ru">Пик</span><span class="de">Gipfel</span></dt>
              <dd>{{ stats.summit_elev_m | int }} m</dd>
            </dl>
          </section>

          {% if stats.waypoints | length >= 2 %}
          <section class="path">
            <h3>
              <span class="en">The path</span>
              <span class="ru">Маршрут</span>
              <span class="de">Route</span>
            </h3>
            <div class="path-box">
              {# Normalise GPX waypoints into a 0..1 box and draw as polyline. #}
              {% set lats = stats.waypoints | map(attribute='lat') | list %}
              {% set lons = stats.waypoints | map(attribute='lon') | list %}
              {% set min_lat = lats | min %}{% set max_lat = lats | max %}
              {% set min_lon = lons | min %}{% set max_lon = lons | max %}
              {% set span_lat = (max_lat - min_lat) or 1e-6 %}
              {% set span_lon = (max_lon - min_lon) or 1e-6 %}
              <svg viewBox="0 0 200 160" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
                <line x1="0" y1="80" x2="200" y2="80" stroke="oklch(0.18 0.01 80 / 0.06)" stroke-width="1"/>
                <polyline
                  fill="none"
                  stroke="oklch(0.18 0.01 80)"
                  stroke-width="1.3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  points="{% for w in stats.waypoints %}{{ (((w.lon - min_lon) / span_lon) * 184 + 8) | round(2) }},{{ (152 - ((w.lat - min_lat) / span_lat) * 144) | round(2) }} {% endfor %}"/>
                {% set first = stats.waypoints[0] %}
                {% set last  = stats.waypoints[-1] %}
                <circle cx="{{ (((first.lon - min_lon) / span_lon) * 184 + 8) | round(2) }}"
                        cy="{{ (152 - ((first.lat - min_lat) / span_lat) * 144) | round(2) }}"
                        r="3.5" fill="oklch(0.18 0.01 80)"/>
                <circle cx="{{ (((last.lon - min_lon) / span_lon) * 184 + 8) | round(2) }}"
                        cy="{{ (152 - ((last.lat - min_lat) / span_lat) * 144) | round(2) }}"
                        r="3.5" fill="oklch(0.972 0.008 80)" stroke="oklch(0.18 0.01 80)" stroke-width="1.5"/>
              </svg>
            </div>
            <p class="path-caption">
              <span class="en">&uarr; N &middot; {{ stats.waypoints | length }} waypoints recorded</span>
              <span class="ru">&uarr; С &middot; {{ stats.waypoints | length }} точек записано</span>
              <span class="de">&uarr; N &middot; {{ stats.waypoints | length }} Punkte aufgezeichnet</span>
            </p>
          </section>
          {% endif %}

          <section class="elev">
            <h3>
              <span class="en">Elevation</span>
              <span class="ru">Высота</span>
              <span class="de">Höhe</span>
            </h3>
            <svg class="elevation" viewBox="0 0 200 36" preserveAspectRatio="none" aria-hidden="true">
              <path fill="oklch(0.18 0.01 80 / 0.08)" d="M 0,36{%- for x, y in elevation %} L {{ (x * 200) | round(2) }},{{ (36 - y * 30) | round(2) }}{% endfor -%} L 200,36 Z"/>
              <polyline fill="none" stroke="oklch(0.18 0.01 80)" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" points="{% for x, y in elevation %}{{ (x * 200) | round(2) }},{{ (36 - y * 30) | round(2) }} {% endfor %}"/>
            </svg>
            <p class="elev-caption">
              {{ stats.start_elev_m | int }}m &rarr;
              {{ stats.summit_elev_m | int }}m &rarr;
              {{ stats.start_elev_m | int }}m
            </p>
          </section>

        </div>
      </aside>

    </div>
  </article>

  <div id="cheat" class="cheat" role="dialog" aria-label="Keyboard shortcuts" hidden>
    <h4>
      <span class="en">Keyboard</span>
      <span class="ru">Клавиатура</span>
      <span class="de">Tastatur</span>
    </h4>
    <dl>
      <dt>&larr; &rarr;</dt><dd>EN &middot; RU &middot; DE</dd>
      <dt>J K</dt><dd><span class="en">paragraph</span><span class="ru">абзац</span><span class="de">Absatz</span></dd>
      <dt>?</dt><dd><span class="en">this help</span><span class="ru">эта справка</span><span class="de">diese Hilfe</span></dd>
    </dl>
  </div>

  <script>
    (function () {
      var LANGS = ['en', 'ru', 'de'];
      var STORAGE_KEY = 'trailstory.lang';

      // ── language toggle ───────────────────────────────────────────
      // The switch itself is pure CSS (hidden radios + :checked); JS
      // adds the swap pulse, scroll anchoring, <html lang>, and
      // persistence on top.
      var langRadios = document.querySelectorAll('.lang-radio');
      var swapNodes = document.querySelectorAll('.swap');

      function currentLang() {
        var checked = document.querySelector('.lang-radio:checked');
        return checked ? checked.value : 'en';
      }

      function applyLang(next) {
        var radio = document.getElementById('lang-' + next);
        if (radio) radio.checked = true;
        document.documentElement.lang = next;
        try { localStorage.setItem(STORAGE_KEY, next); } catch (e) {}
      }

      // Scroll preservation by paragraph anchor: remember the y-offset
      // of the first visible <p> in the active body, restore the same
      // paragraph's offset after the swap.
      function captureAnchor() {
        var activeBody = document.querySelector('.prose .body');
        if (!activeBody) return null;
        var ps = activeBody.querySelectorAll('p.' + currentLang());
        for (var i = 0; i < ps.length; i++) {
          var r = ps[i].getBoundingClientRect();
          if (r.bottom > 0) return { idx: i, y: r.top };
        }
        return null;
      }

      function restoreAnchor(anchor, lang) {
        if (!anchor) return;
        var nextBody = document.querySelector('.prose .body');
        if (!nextBody) return;
        var nps = nextBody.querySelectorAll('p.' + lang);
        if (nps[anchor.idx]) {
          var newY = nps[anchor.idx].getBoundingClientRect().top;
          window.scrollBy({ top: newY - anchor.y, behavior: 'instant' });
        }
      }

      function pulseSwap() {
        swapNodes.forEach(function (n) { n.classList.add('is-swapping'); });
        window.setTimeout(function () {
          swapNodes.forEach(function (n) { n.classList.remove('is-swapping'); });
        }, 180);
      }

      // Label clicks fire before the radio flips, so the pre-swap
      // geometry is still measurable here.
      var pendingAnchor = null;
      document.querySelectorAll('.lang label').forEach(function (lbl) {
        lbl.addEventListener('click', function () {
          pendingAnchor = captureAnchor();
        });
      });

      langRadios.forEach(function (r) {
        r.addEventListener('change', function () {
          var anchor = pendingAnchor;
          pendingAnchor = null;
          applyLang(r.value);
          restoreAnchor(anchor, r.value);
          pulseSwap();
        });
      });

      // Programmatic switch (keyboard shortcuts). Setting `checked`
      // in JS fires no 'change' event, so pulse and anchor here.
      function setLang(next) {
        if (next === currentLang()) return;
        var anchor = captureAnchor();
        applyLang(next);
        restoreAnchor(anchor, next);
        pulseSwap();
      }

      // Initial language: stored value → navigator language → 'en'.
      var stored = null;
      try { stored = localStorage.getItem(STORAGE_KEY); } catch (e) {}
      if (stored && LANGS.indexOf(stored) >= 0) {
        applyLang(stored);
      } else {
        var nav = (navigator.language || 'en').toLowerCase();
        if (nav.indexOf('ru') === 0) applyLang('ru');
        else if (nav.indexOf('de') === 0) applyLang('de');
        else applyLang('en');
      }

      // ── reading progress bar ──────────────────────────────────────
      var article = document.getElementById('article');
      var progress = document.getElementById('progress');
      function tickProgress() {
        if (!article) return;
        var r = article.getBoundingClientRect();
        var total = r.height - window.innerHeight;
        var read = Math.min(Math.max(-r.top, 0), Math.max(total, 1));
        var pct = total > 0 ? (read / total) * 100 : 0;
        progress.style.width = pct.toFixed(2) + '%';
      }
      tickProgress();
      window.addEventListener('scroll', tickProgress, { passive: true });
      window.addEventListener('resize', tickProgress);

      // ── chapter rail (paragraph ticks on ≥1280px) ────────────────
      function buildRail() {
        var rail = document.getElementById('rail');
        if (!rail || !window.matchMedia('(min-width: 1280px)').matches) return;
        var activeBody = document.querySelector('.prose .body');
        if (!activeBody) return;
        var ps = activeBody.querySelectorAll('p.' + currentLang());
        rail.innerHTML = '';
        if (ps.length < 2) return;
        ps.forEach(function (p, i) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.setAttribute('aria-label', 'Jump to paragraph ' + (i + 1));
          btn.innerHTML = '<span class="tick"></span>';
          btn.addEventListener('click', function () {
            p.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
          rail.appendChild(btn);
        });
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            var idx = Array.prototype.indexOf.call(ps, e.target);
            Array.prototype.forEach.call(rail.children, function (b, j) {
              b.setAttribute('aria-current', String(j === idx));
            });
          });
        }, { rootMargin: '-40% 0px -40% 0px' });
        ps.forEach(function (p) { io.observe(p); });
      }
      buildRail();

      // ── pull-quote entrance ──────────────────────────────────────
      var quote = document.getElementById('quote');
      if (quote && 'IntersectionObserver' in window) {
        var qio = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { quote.classList.add('seen'); qio.disconnect(); }
          });
        }, { threshold: 0.25 });
        qio.observe(quote);
      } else if (quote) {
        quote.classList.add('seen');
      }

      // ── photo blur-up ────────────────────────────────────────────
      document.querySelectorAll('.figure img').forEach(function (img) {
        if (img.complete) { img.classList.add('loaded'); }
        else { img.addEventListener('load', function () { img.classList.add('loaded'); }); }
      });

      // ── marginalia collapse (mobile only) ────────────────────────
      var margin = document.getElementById('margin');
      var marginToggle = document.getElementById('marginToggle');
      if (marginToggle && margin) {
        // On phones, default closed; on tablets, default open.
        if (window.matchMedia('(max-width: 599px)').matches) {
          margin.setAttribute('data-open', 'false');
          marginToggle.setAttribute('aria-expanded', 'false');
          marginToggle.querySelector('.sign').innerHTML = '+';
        }
        marginToggle.addEventListener('click', function () {
          var open = margin.getAttribute('data-open') !== 'false';
          margin.setAttribute('data-open', open ? 'false' : 'true');
          marginToggle.setAttribute('aria-expanded', open ? 'false' : 'true');
          marginToggle.querySelector('.sign').innerHTML = open ? '+' : '&minus;';
        });
      }

      // ── share row ────────────────────────────────────────────────
      var titles = {
        en: {{ narrative.title.en | tojson }},
        ru: {{ narrative.title.ru | tojson }},
        de: {{ narrative.title.de | tojson }}
      };
      var quotes = {
        en: {{ narrative.pull_quote.en | tojson }},
        ru: {{ narrative.pull_quote.ru | tojson }},
        de: {{ narrative.pull_quote.de | tojson }}
      };
      var labels = {
        en: { sending: 'Building carousel…', ready: 'Carousel ready. Click each slide to save.', shared: 'Saved. Open Instagram and pick the slides from your library.', error: 'Could not build carousel: ', htmlPreparing: 'Preparing page…', htmlAgain: 'Ready — tap again to share.', htmlShared: 'Shared.', htmlSaved: 'Downloaded — attach the .html file in any messenger.', htmlError: 'Could not share the page: ' },
        ru: { sending: 'Собираем карусель…', ready: 'Карусель готова. Скачайте каждый слайд.', shared: 'Сохранено. Откройте Instagram и выберите слайды из галереи.', error: 'Не удалось собрать карусель: ', htmlPreparing: 'Готовим страницу…', htmlAgain: 'Готово — нажмите ещё раз.', htmlShared: 'Отправлено.', htmlSaved: 'Скачано — прикрепите .html-файл в любом мессенджере.', htmlError: 'Не удалось поделиться страницей: ' },
        de: { sending: 'Karussell wird erstellt…', ready: 'Karussell fertig. Slide einzeln speichern.', shared: 'Gespeichert. Instagram öffnen und Slides aus der Galerie wählen.', error: 'Karussell fehlgeschlagen: ', htmlPreparing: 'Seite wird vorbereitet…', htmlAgain: 'Bereit — noch einmal tippen.', htmlShared: 'Geteilt.', htmlSaved: 'Heruntergeladen — die .html-Datei in einem Messenger anhängen.', htmlError: 'Seite konnte nicht geteilt werden: ' }
      };

      var pdfBtn  = document.getElementById('pdfBtn');
      var htmlBtn = document.getElementById('htmlBtn');
      var igBtn   = document.getElementById('igBtn');
      var igStatus = document.getElementById('igStatus');

      function shareMessage() {
        var lg = currentLang();
        return titles[lg] + ' — ' + quotes[lg];
      }

      if (pdfBtn) {
        // The @media print stylesheet strips the chrome and keeps only the
        // currently selected language, so the browser's "Save as PDF"
        // destination produces a clean single-language document.
        pdfBtn.addEventListener('click', function () { window.print(); });
      }

      // The page itself is the shareable artifact (ADR-001): one
      // self-contained .html file. We always serialize a cleaned clone
      // of the live DOM — photos survive as inline data URIs, the
      // clone drops transient UI state, the `js` marker class comes
      // off (a forwarded copy must render in no-JS previews), and the
      // reader's current language is baked in as the copy's default.
      // The result is cached per language: pages carry multi-MB of
      // photos, and navigator.share() must run inside the tap's
      // transient-activation window.
      var pageFilePromise = null;
      var pageFileLang = null;
      function pageAsFile() {
        if (pageFilePromise && pageFileLang === currentLang()) return pageFilePromise;
        var name = {{ meta.slug | tojson }} + '.html';
        pageFileLang = currentLang();
        pageFilePromise = Promise.resolve().then(function () {
          var root = document.documentElement.cloneNode(true);
          root.classList.remove('js');
          var lg = currentLang();
          root.querySelectorAll('.lang-radio').forEach(function (r) {
            if (r.value === lg) r.setAttribute('checked', '');
            else r.removeAttribute('checked');
          });
          root.querySelectorAll('img.loaded').forEach(function (img) {
            img.classList.remove('loaded');
          });
          root.querySelectorAll('.is-swapping, .seen').forEach(function (n) {
            n.classList.remove('is-swapping');
            n.classList.remove('seen');
          });
          var btn = root.querySelector('#htmlBtn');
          if (btn) btn.removeAttribute('disabled');
          var status = root.querySelector('#igStatus');
          if (status) status.textContent = '';
          var fb = root.querySelector('#igFallback');
          if (fb && fb.parentNode) fb.parentNode.removeChild(fb);
          var blob = new Blob(['<!doctype html>\n' + root.outerHTML], { type: 'text/html' });
          return new File([blob], name, { type: 'text/html' });
        });
        pageFilePromise.catch(function () { pageFilePromise = null; });
        return pageFilePromise;
      }

      if (htmlBtn) {
        // Warm the page bytes before the click lands.
        htmlBtn.addEventListener('pointerenter', pageAsFile);
        htmlBtn.addEventListener('touchstart', pageAsFile, { passive: true });
        htmlBtn.addEventListener('click', async function () {
          var lg = currentLang();
          htmlBtn.disabled = true;
          igStatus.textContent = labels[lg].htmlPreparing;
          try {
            var file = await pageAsFile();
            if (navigator.canShare && navigator.canShare({ files: [file] })) {
              try {
                await navigator.share({ files: [file], title: titles[lg], text: shareMessage() });
                igStatus.textContent = labels[lg].htmlShared;
                htmlBtn.disabled = false;
                return;
              } catch (e) {
                if (e && e.name === 'AbortError') { igStatus.textContent = ''; htmlBtn.disabled = false; return; }
                if (e && e.name === 'NotAllowedError') {
                  // Activation expired during the first fetch; the file is
                  // cached now, so the next tap shares instantly.
                  igStatus.textContent = labels[lg].htmlAgain;
                  htmlBtn.disabled = false;
                  return;
                }
                /* share sheet unavailable → fall through to download */
              }
            }
            var url = URL.createObjectURL(file);
            var a = document.createElement('a');
            a.href = url; a.download = file.name;
            document.body.appendChild(a); a.click(); a.remove();
            window.setTimeout(function () { URL.revokeObjectURL(url); }, 60000);
            igStatus.textContent = labels[lg].htmlSaved;
          } catch (err) {
            igStatus.textContent = labels[lg].htmlError + (err && err.message ? err.message : 'unknown');
          }
          htmlBtn.disabled = false;
        });
      }

      function showFallbackLinks(urls) {
        var existing = document.getElementById('igFallback');
        if (existing) existing.remove();
        var box = document.createElement('div');
        box.id = 'igFallback'; box.className = 'ig-fallback';
        urls.forEach(function (u, i) {
          var a = document.createElement('a');
          a.href = u; a.textContent = 'Slide ' + (i + 1); a.setAttribute('download', '');
          box.appendChild(a);
        });
        igStatus.parentNode.insertBefore(box, igStatus.nextSibling);
      }

      if (igBtn) {
        var slug = igBtn.getAttribute('data-slug');
        igBtn.addEventListener('click', async function () {
          var lg = currentLang();
          igBtn.disabled = true;
          igStatus.textContent = labels[lg].sending;
          try {
            var res = await fetch('/memory/' + slug + '/carousel', { method: 'POST' });
            if (!res.ok) throw new Error('HTTP ' + res.status);
            var data = await res.json();
            var urls = (data && data.slides) || [];
            if (!urls.length) throw new Error('no slides');

            if (navigator.canShare) {
              try {
                var files = await Promise.all(urls.map(async function (u) {
                  var fr = await fetch(u);
                  var blob = await fr.blob();
                  var name = u.split('/').pop() || 'slide.jpg';
                  return new File([blob], name, { type: blob.type || 'image/jpeg' });
                }));
                var shareData = { files: files, title: titles[lg], text: shareMessage() };
                if (navigator.canShare(shareData)) {
                  await navigator.share(shareData);
                  igStatus.textContent = labels[lg].shared;
                  igBtn.disabled = false;
                  return;
                }
              } catch (e) { /* user dismissed share sheet → fall through */ }
            }
            igStatus.textContent = labels[lg].ready;
            showFallbackLinks(urls);
          } catch (err) {
            igStatus.textContent = labels[lg].error + (err && err.message ? err.message : 'unknown');
          }
          igBtn.disabled = false;
        });
      }

      // ── back-to-builder link ─────────────────────────────────────
      // Visible only when served by the web builder; a saved or
      // forwarded copy (file://, other hosts' paths) keeps it hidden.
      var backNav = document.getElementById('backNav');
      if (backNav && /^https?:$/.test(location.protocol) && location.pathname.indexOf('/memory/') === 0) {
        backNav.hidden = false;
      }

      // ── keyboard shortcuts ───────────────────────────────────────
      var cheat = document.getElementById('cheat');
      document.addEventListener('keydown', function (e) {
        // Ignore if the user is typing somewhere (won't happen on this
        // static page, but defensive in case).
        if (e.target && /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName)) return;

        if (cheat && !cheat.hidden && e.key !== '?') {
          cheat.hidden = true; return;
        }
        var lg = currentLang();
        var idx = LANGS.indexOf(lg);
        if (e.key === 'ArrowRight') { setLang(LANGS[(idx + 1) % LANGS.length]); e.preventDefault(); }
        else if (e.key === 'ArrowLeft') { setLang(LANGS[(idx + LANGS.length - 1) % LANGS.length]); e.preventDefault(); }
        else if (e.key === 'j' || e.key === 'J' || e.key === 'k' || e.key === 'K') {
          var dir = (e.key === 'j' || e.key === 'J') ? 1 : -1;
          var body = document.querySelector('.prose .body');
          if (!body) return;
          var ps = body.querySelectorAll('p.' + lg);
          var target = null;
          for (var i = 0; i < ps.length; i++) {
            var r = ps[i].getBoundingClientRect();
            if (dir === 1 && r.top > 24) { target = ps[i]; break; }
            if (dir === -1 && r.top >= -2) { target = ps[Math.max(0, i - 1)]; break; }
          }
          if (target) { target.scrollIntoView({ behavior: 'smooth', block: 'start' }); e.preventDefault(); }
        }
        else if (e.key === '?') {
          cheat.hidden = !cheat.hidden;
          e.preventDefault();
        }
      });
    })();
  </script>
</body>
</html>

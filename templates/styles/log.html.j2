<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ narrative.title.en }}</title>
<style>
  *, *::before, *::after { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    font-family: ui-sans-serif, "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    color: #1f2328;
    background: #f4f5f7;
    line-height: 1.45;
    -webkit-font-smoothing: antialiased;
  }
  main {
    max-width: 640px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }

  /* hero — log-entry header: monospace timestamp, compact meta line */
  header.hero {
    border-top: 2px solid #1f2328;
    border-bottom: 1px solid #d0d7de;
    padding: 0.75rem 0;
    margin-bottom: 1.25rem;
  }
  .log-stamp {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #57606a;
    margin-bottom: 0.4rem;
  }
  .milestone {
    display: inline-block;
    padding: 0.12rem 0.45rem;
    background: #1f2328;
    color: #f4f5f7;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-right: 0.4rem;
    font-weight: 600;
  }
  h1 {
    font-size: 1.55rem;
    margin: 0.25rem 0 0.35rem;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .subtitle {
    margin: 0;
    font-size: 0.95rem;
    color: #57606a;
    font-weight: 400;
  }

  /* lang toggle */
  .lang-toggle { position: fixed; top: 0.5rem; right: 0.5rem; z-index: 10; }
  .lang-toggle button {
    background: #1f2328;
    color: #f4f5f7;
    border: 0;
    border-radius: 4px;
    padding: 0.3rem 0.7rem;
    font: inherit;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    cursor: pointer;
  }

  /* ── about this place (ADR-017) ──────────────────────────────────── */
  .place {
    margin: 0 0 28px;
    padding: 16px 18px;
    background: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 6px;
  }
  .place-head {
    margin: 0 0 8px;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 12px; font-weight: 600;
    letter-spacing: 0.02em; color: #57606a;
  }
  .place .place-summary { margin: 0; font-size: 15px; line-height: 1.55; color: #1f2328; }
  .place .place-source {
    margin: 10px 0 0;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 11px;
  }
  .place .place-source a { color: #57606a; text-decoration: none; }
  .place .place-source a:hover { color: #1f2328; text-decoration: underline; }

  body.lang-en .ru, body.lang-en .de { display: none; }
  body.lang-ru .en, body.lang-ru .de { display: none; }
  body.lang-de .en, body.lang-de .ru { display: none; }

  @media print {
    .lang-toggle, .share { display: none !important; }
    body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    figure { page-break-inside: avoid; }
  }
  /* stats — list, not a grid; aligned key/value pairs */
  .stats {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem;
    border: 1px solid #d0d7de;
    background: #ffffff;
  }
  .stats li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.55rem 0.85rem;
    border-bottom: 1px solid #eaeef2;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.85rem;
  }
  .stats li:last-child { border-bottom: 0; }
  .stats .l {
    color: #57606a;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.7rem;
  }
  .stats .v { color: #1f2328; font-weight: 600; }

  /* elevation profile — flat sparkline, no fill */
  .elevation {
    width: 100%;
    height: 60px;
    margin-bottom: 1.25rem;
    display: block;
    background: #ffffff;
    border: 1px solid #d0d7de;
    padding: 4px;
  }
  .elevation path {
    fill: none;
    stroke: #1f2328;
    stroke-width: 0.5;
    stroke-linejoin: round;
  }

  /* article — compact, narrower line height */
  article p { font-size: 0.95rem; margin: 0 0 0.85rem; }
  blockquote {
    border-left: 2px solid #1f2328;
    margin: 1.25rem 0;
    padding: 0.1rem 0.85rem;
    font-size: 1rem;
    color: #1f2328;
    background: #ffffff;
  }

  /* photos — list of dated entries with caption */
  .photos {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin: 1.5rem 0;
  }
  .photos figure {
    margin: 0;
    background: #ffffff;
    border: 1px solid #d0d7de;
    padding: 6px;
  }
  .photos img {
    width: 100%;
    height: auto;
    display: block;
    max-height: 260px;
    object-fit: cover;
  }
  .photos figcaption {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.7rem;
    color: #57606a;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.45rem 0.15rem 0.1rem;
  }

  /* share */
  .share {
    margin: 2rem 0 1rem;
    padding-top: 1rem;
    border-top: 1px solid #d0d7de;
  }
  .share a, .share button {
    display: inline-block;
    margin: 0 0.5rem 0 0;
    padding: 0.35rem 0.75rem;
    border-radius: 4px;
    background: #1f2328;
    color: #f4f5f7;
    text-decoration: none;
    border: 0;
    font: inherit;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    cursor: pointer;
  }

  footer {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    color: #8c959f;
    font-size: 0.7rem;
    margin-top: 1.5rem;
    border-top: 1px solid #d0d7de;
    padding-top: 0.75rem;
  }
</style>
</head>
<body class="lang-en style-log">
  <div class="lang-toggle">
    <button id="langBtn" type="button" aria-label="Switch language">EN · RU · DE</button>
  </div>

  <main>
    <header class="hero">
      <div class="log-stamp">
        Log entry
        {% if meta.date %} · {{ meta.date }}{% endif %}
        {% if meta.location %} · {{ meta.location }}{% endif %}
      </div>
      <span class="milestone">
        <span class="en">{{ narrative.milestone.en }}</span>
        <span class="ru">{{ narrative.milestone.ru }}</span>
        <span class="de">{{ narrative.milestone.de }}</span>
      </span>
      <h1>
        <span class="en">{{ narrative.title.en }}</span>
        <span class="ru">{{ narrative.title.ru }}</span>
        <span class="de">{{ narrative.title.de }}</span>
      </h1>
      <p class="subtitle">
        <span class="en">{{ narrative.subtitle.en }}</span>
        <span class="ru">{{ narrative.subtitle.ru }}</span>
        <span class="de">{{ narrative.subtitle.de }}</span>
      </p>
    </header>

    <ul class="stats" aria-label="hike stats">
      <li><span class="l">distance</span><span class="v">{{ stats.distance_km }} km</span></li>
      <li><span class="l">elev. gain</span><span class="v">{{ stats.elevation_gain_m | int }} m</span></li>
      <li><span class="l">duration</span><span class="v">{{ stats.duration_min }} min</span></li>
      <li><span class="l">summit</span><span class="v">{{ stats.summit_elev_m | int }} m</span></li>
    </ul>

    <svg class="elevation" viewBox="0 0 100 30" preserveAspectRatio="none" aria-hidden="true">
      <path d="M 0,30
        {%- for x, y in elevation %} L {{ (x * 100) | round(2) }},{{ (30 - y * 25) | round(2) }}{% endfor -%}
         L 100,30"/>
    </svg>

    {# ADR-017: "about this place" — conditional on a resolved PlaceContext.
       Log idiom: a lowercase mono label, then the grounded note. #}
    {% if place %}
    <section class="place" aria-label="about this place">
      <h2 class="place-head">
        <span class="en">// about {{ place.town }}</span>
        <span class="ru">// о месте: {{ place.town }}</span>
        <span class="de">// über {{ place.town }}</span>
      </h2>
      <p class="place-summary">
        <span class="en">{{ place.summary.en }}</span>
        <span class="ru">{{ place.summary.ru }}</span>
        <span class="de">{{ place.summary.de }}</span>
      </p>
      {% if place.source_url or place.named_landmarks %}
      <p class="place-source">{% if place.source_url %}<a href="{{ place.source_url }}" target="_blank" rel="noopener noreferrer">
        <span class="en">source: {{ place.source_title or place.town }}</span>
        <span class="ru">источник: {{ place.source_title or place.town }}</span>
        <span class="de">quelle: {{ place.source_title or place.town }}</span>
      </a>{% endif %}{% if place.named_landmarks %}{% if place.source_url %} · {% endif %}<a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">© OpenStreetMap contributors</a>{% endif %}</p>
      {% endif %}
    </section>
    {% endif %}

    <article>
      {# ADR-014 (Phase 4): paragraphs is a list of Paragraph, each a
         list of Sentence with tri-lingual text. Provenance stays in
         the data model for the quality gates but is not rendered. #}
      <div class="en">
        {% for paragraph in narrative.paragraphs %}
          <p>
            {% for sentence in paragraph -%}
              {{ sentence.text.en }}{% if not loop.last %} {% endif -%}
            {% endfor %}
          </p>
        {% endfor %}
      </div>
      <div class="ru">
        {% for paragraph in narrative.paragraphs %}
          <p>
            {% for sentence in paragraph -%}
              {{ sentence.text.ru }}{% if not loop.last %} {% endif -%}
            {% endfor %}
          </p>
        {% endfor %}
      </div>
      <div class="de">
        {% for paragraph in narrative.paragraphs %}
          <p>
            {% for sentence in paragraph -%}
              {{ sentence.text.de }}{% if not loop.last %} {% endif -%}
            {% endfor %}
          </p>
        {% endfor %}
      </div>

      <blockquote>
        <span class="en">{{ narrative.pull_quote.en }}</span>
        <span class="ru">{{ narrative.pull_quote.ru }}</span>
        <span class="de">{{ narrative.pull_quote.de }}</span>
      </blockquote>
    </article>

    <section class="photos">
      {% for photo in photos %}
      <figure>
        <img src="{{ photo.data_uri }}" alt="" loading="lazy">
        <figcaption>frame {{ "%02d" | format(loop.index) }} / {{ photos | length }}</figcaption>
      </figure>
      {% endfor %}
    </section>

    <section class="share" aria-label="share">
      <button id="pdfBtn" type="button">Save as PDF</button>
      <button id="htmlBtn" type="button">Share page (HTML file)</button>
      <button id="igBtn" type="button" data-slug="{{ meta.slug }}">Save for Instagram</button>
      <p id="igStatus" class="ig-status" aria-live="polite"></p>
    </section>

    <footer>{{ meta.slug }}</footer>
  </main>

  <style>
    .ig-status {
      font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
      font-size: 0.7rem;
      color: #57606a;
      margin-top: 0.45rem;
      min-height: 1.2em;
      letter-spacing: 0.04em;
    }
    .ig-fallback { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.5rem; }
    .ig-fallback a {
      display: inline-block;
      padding: 0.3rem 0.6rem;
      border: 1px solid #d0d7de;
      background: #ffffff;
      color: #1f2328 !important;
      text-decoration: none;
      border-radius: 3px;
      font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
      font-size: 0.7rem;
      letter-spacing: 0.04em;
    }
  </style>

  <script>
    (function () {
      var langs = ['en', 'ru', 'de'];
      var labels = { en: 'EN · RU · DE', ru: 'RU · DE · EN', de: 'DE · EN · RU' };
      var btn = document.getElementById('langBtn');

      function currentLang() {
        for (var i = 0; i < langs.length; i++) {
          if (document.body.classList.contains('lang-' + langs[i])) return langs[i];
        }
        return 'en';
      }

      function setLang(next) {
        for (var i = 0; i < langs.length; i++) {
          document.body.classList.remove('lang-' + langs[i]);
        }
        document.body.classList.add('lang-' + next);
        document.documentElement.lang = next;
        btn.textContent = labels[next];
      }

      btn.addEventListener('click', function () {
        var idx = langs.indexOf(currentLang());
        setLang(langs[(idx + 1) % langs.length]);
      });

      var titleEn = {{ narrative.title.en | tojson }};
      var quoteEn = {{ narrative.pull_quote.en | tojson }};
      var msg = titleEn + ' — ' + quoteEn;

      // The @media print stylesheet strips the chrome and keeps only the
      // active language, so the browser's "Save as PDF" destination
      // produces a clean single-language document.
      document.getElementById('pdfBtn').addEventListener('click', function () {
        window.print();
      });

      // The page itself is the shareable artifact (ADR-001): one
      // self-contained .html file. Served over http(s) we re-fetch our own
      // URL for the original bytes; opened from disk (file://), fetch is
      // blocked, so we serialize a cleaned clone of the live DOM — photos
      // survive as inline data URIs, and the clone drops transient UI
      // state (disabled buttons, status text) so a forwarded copy works
      // for the next reader too. The result is cached: pages carry
      // multi-MB of photos, and navigator.share() must run inside the
      // tap's transient-activation window.
      var pageFilePromise = null;
      function pageAsFile() {
        if (pageFilePromise) return pageFilePromise;
        var name = {{ meta.slug | tojson }} + '.html';
        pageFilePromise = fetch(window.location.href)
          .then(function (res) {
            if (!res.ok) throw new Error('HTTP ' + res.status);
            return res.blob();
          })
          .catch(function () {
            var root = document.documentElement.cloneNode(true);
            var btn = root.querySelector('#htmlBtn');
            if (btn) btn.removeAttribute('disabled');
            var status = root.querySelector('#igStatus');
            if (status) status.textContent = '';
            var fb = root.querySelector('#igFallback');
            if (fb && fb.parentNode) fb.parentNode.removeChild(fb);
            return new Blob(['<!doctype html>\n' + root.outerHTML], { type: 'text/html' });
          })
          .then(function (blob) { return new File([blob], name, { type: 'text/html' }); });
        pageFilePromise.catch(function () { pageFilePromise = null; });
        return pageFilePromise;
      }

      var htmlBtn = document.getElementById('htmlBtn');
      // Warm the page bytes before the click lands.
      htmlBtn.addEventListener('pointerenter', pageAsFile);
      htmlBtn.addEventListener('touchstart', pageAsFile, { passive: true });
      htmlBtn.addEventListener('click', async function () {
        htmlBtn.disabled = true;
        setStatus('Preparing page…');
        try {
          var file = await pageAsFile();
          if (navigator.canShare && navigator.canShare({ files: [file] })) {
            try {
              await navigator.share({ files: [file], title: titleEn, text: msg });
              setStatus('Shared.');
              htmlBtn.disabled = false;
              return;
            } catch (e) {
              if (e && e.name === 'AbortError') { setStatus(''); htmlBtn.disabled = false; return; }
              if (e && e.name === 'NotAllowedError') {
                // Activation expired during the first fetch; the file is
                // cached now, so the next tap shares instantly.
                setStatus('Ready — tap again to share.');
                htmlBtn.disabled = false;
                return;
              }
              // Share sheet unavailable; fall through to download.
            }
          }
          var url = URL.createObjectURL(file);
          var a = document.createElement('a');
          a.href = url; a.download = file.name;
          document.body.appendChild(a); a.click(); a.remove();
          window.setTimeout(function () { URL.revokeObjectURL(url); }, 60000);
          setStatus('Downloaded — attach the .html file in any messenger.');
        } catch (err) {
          setStatus('Could not share the page: ' + (err && err.message ? err.message : 'unknown'));
        }
        htmlBtn.disabled = false;
      });

      // ── Instagram carousel ────────────────────────────────────────
      var igBtn = document.getElementById('igBtn');
      var igStatus = document.getElementById('igStatus');
      var slug = igBtn.getAttribute('data-slug');

      function setStatus(text) { igStatus.textContent = text || ''; }

      async function fetchSlideAsFile(url) {
        var res = await fetch(url);
        if (!res.ok) throw new Error('failed to fetch ' + url);
        var blob = await res.blob();
        var name = url.split('/').pop() || 'slide.jpg';
        return new File([blob], name, { type: blob.type || 'image/jpeg' });
      }

      function showFallbackLinks(urls) {
        var existing = document.getElementById('igFallback');
        if (existing) existing.remove();
        var box = document.createElement('div');
        box.id = 'igFallback';
        box.className = 'ig-fallback';
        urls.forEach(function (u, i) {
          var a = document.createElement('a');
          a.href = u;
          a.textContent = 'slide ' + (i + 1);
          a.setAttribute('download', '');
          box.appendChild(a);
        });
        igStatus.parentNode.insertBefore(box, igStatus.nextSibling);
      }

      async function saveForInstagram() {
        igBtn.disabled = true;
        setStatus('Building carousel…');
        try {
          var manifestRes = await fetch('/memory/' + slug + '/carousel', { method: 'POST' });
          if (!manifestRes.ok) throw new Error('carousel build failed (' + manifestRes.status + ')');
          var manifest = await manifestRes.json();
          var urls = (manifest && manifest.slides) || [];
          if (!urls.length) throw new Error('no slides returned');

          if (navigator.canShare) {
            setStatus('Preparing share sheet…');
            var files = await Promise.all(urls.map(fetchSlideAsFile));
            var shareData = { files: files, title: titleEn, text: msg };
            if (navigator.canShare(shareData)) {
              try {
                await navigator.share(shareData);
                setStatus('Saved. Open Instagram and pick the slides from your library.');
                igBtn.disabled = false;
                return;
              } catch (err) {
                // User dismissed; fall through to download links.
              }
            }
          }

          setStatus('Carousel ready. Click each slide to download.');
          showFallbackLinks(urls);
        } catch (err) {
          setStatus('Could not build carousel: ' + (err && err.message ? err.message : 'unknown'));
        }
        igBtn.disabled = false;
      }

      igBtn.addEventListener('click', saveForInstagram);
    })();
  </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ narrative.title.en }}</title>
<style>
  *, *::before, *::after { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    font-family: ui-sans-serif, "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    color: #1f2328;
    background: #f4f5f7;
    line-height: 1.45;
    -webkit-font-smoothing: antialiased;
  }
  main {
    max-width: 640px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }

  /* hero — log-entry header: monospace timestamp, compact meta line */
  header.hero {
    border-top: 2px solid #1f2328;
    border-bottom: 1px solid #d0d7de;
    padding: 0.75rem 0;
    margin-bottom: 1.25rem;
  }
  .log-stamp {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #57606a;
    margin-bottom: 0.4rem;
  }
  .milestone {
    display: inline-block;
    padding: 0.12rem 0.45rem;
    background: #1f2328;
    color: #f4f5f7;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-right: 0.4rem;
    font-weight: 600;
  }
  h1 {
    font-size: 1.55rem;
    margin: 0.25rem 0 0.35rem;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .subtitle {
    margin: 0;
    font-size: 0.95rem;
    color: #57606a;
    font-weight: 400;
  }

  /* lang toggle */
  .lang-toggle { position: fixed; top: 0.5rem; right: 0.5rem; z-index: 10; }
  .lang-toggle button {
    background: #1f2328;
    color: #f4f5f7;
    border: 0;
    border-radius: 4px;
    padding: 0.3rem 0.7rem;
    font: inherit;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    cursor: pointer;
  }

  body.lang-en .ru, body.lang-en .de { display: none; }
  body.lang-ru .en, body.lang-ru .de { display: none; }
  body.lang-de .en, body.lang-de .ru { display: none; }

  /* ADR-014 / Phase 4: sentence-level provenance.
     The log register can't carry editorial's always-on treatment
     without looking busy, so provenance is opt-in here via a "Notes"
     toggle next to the language switcher. The vocabulary (body.audit,
     #notesBtn, data-tip, localStorage key) mirrors editorial.html.j2
     so a creator who turns notes on in one style sees the same audit
     UI everywhere.

     When body.audit is set:
       - INFERRED sentences gain a faint highlighter background
       - Per-source bottom-edge underline colors mark photo / seed /
         gpx provenance (matches editorial)
       - Hovering any sentence surfaces a custom ::after tooltip
         reading data-tip (the native title attribute is slow,
         low-contrast, and absent on touch — same fix as editorial)
     When unset, the sentence spans render as plain text. */
  .sent {
    transition: background-color 120ms ease, box-shadow 120ms ease;
  }
  body.audit .sent { position: relative; }
  body.audit .sent[data-prov="inferred"] {
    background: #fff8d4;
    border-radius: 2px;
    padding: 0 2px;
  }
  body.audit .sent[data-prov="photo"]  { box-shadow: inset 0 -2px 0 oklch(0.78 0.10 220 / 0.55); }
  body.audit .sent[data-prov="seed"]   { box-shadow: inset 0 -2px 0 oklch(0.78 0.10 150 / 0.55); }
  body.audit .sent[data-prov="gpx"]    { box-shadow: inset 0 -2px 0 oklch(0.78 0.06 60  / 0.55); }
  body.audit .sent:hover {
    background: #ffeb9c;
    cursor: help;
  }
  body.audit .sent:hover::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + 4px); left: 0;
    background: #1f2328; color: #f4f5f7;
    padding: 6px 8px;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 11px;
    letter-spacing: 0.02em; line-height: 1.35;
    max-width: 280px; white-space: normal;
    border-radius: 2px;
    z-index: 30; pointer-events: none;
    box-shadow: 0 4px 10px rgba(0,0,0,0.18);
  }
  @media print {
    body.audit .sent[data-prov] { background: transparent; box-shadow: none; }
  }

  /* ── notes (audit) toggle ──────────────────────────────────────── */
  .article-tools {
    display: flex;
    justify-content: flex-end;
    margin: 0 0 0.5rem;
  }
  .article-tools button {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: transparent;
    color: #57606a;
    border: 1px solid #d0d7de;
    padding: 0.25rem 0.6rem;
    cursor: pointer;
    border-radius: 3px;
  }
  .article-tools button:hover {
    border-color: #1f2328;
    color: #1f2328;
  }
  .article-tools button[aria-pressed="true"] {
    background: #1f2328;
    color: #f4f5f7;
    border-color: #1f2328;
  }

  /* stats — list, not a grid; aligned key/value pairs */
  .stats {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem;
    border: 1px solid #d0d7de;
    background: #ffffff;
  }
  .stats li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.55rem 0.85rem;
    border-bottom: 1px solid #eaeef2;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.85rem;
  }
  .stats li:last-child { border-bottom: 0; }
  .stats .l {
    color: #57606a;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.7rem;
  }
  .stats .v { color: #1f2328; font-weight: 600; }

  /* elevation profile — flat sparkline, no fill */
  .elevation {
    width: 100%;
    height: 60px;
    margin-bottom: 1.25rem;
    display: block;
    background: #ffffff;
    border: 1px solid #d0d7de;
    padding: 4px;
  }
  .elevation path {
    fill: none;
    stroke: #1f2328;
    stroke-width: 0.5;
    stroke-linejoin: round;
  }

  /* article — compact, narrower line height */
  article p { font-size: 0.95rem; margin: 0 0 0.85rem; }
  blockquote {
    border-left: 2px solid #1f2328;
    margin: 1.25rem 0;
    padding: 0.1rem 0.85rem;
    font-size: 1rem;
    color: #1f2328;
    background: #ffffff;
  }

  /* photos — list of dated entries with caption */
  .photos {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin: 1.5rem 0;
  }
  .photos figure {
    margin: 0;
    background: #ffffff;
    border: 1px solid #d0d7de;
    padding: 6px;
  }
  .photos img {
    width: 100%;
    height: auto;
    display: block;
    max-height: 260px;
    object-fit: cover;
  }
  .photos figcaption {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.7rem;
    color: #57606a;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.45rem 0.15rem 0.1rem;
  }

  /* share */
  .share {
    margin: 2rem 0 1rem;
    padding-top: 1rem;
    border-top: 1px solid #d0d7de;
  }
  .share a, .share button {
    display: inline-block;
    margin: 0 0.5rem 0 0;
    padding: 0.35rem 0.75rem;
    border-radius: 4px;
    background: #1f2328;
    color: #f4f5f7;
    text-decoration: none;
    border: 0;
    font: inherit;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    cursor: pointer;
  }

  footer {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    color: #8c959f;
    font-size: 0.7rem;
    margin-top: 1.5rem;
    border-top: 1px solid #d0d7de;
    padding-top: 0.75rem;
  }
</style>
</head>
<body class="lang-en style-log">
  <div class="lang-toggle">
    <button id="langBtn" type="button" aria-label="Switch language">EN · RU · DE</button>
  </div>

  <main>
    <header class="hero">
      <div class="log-stamp">
        Log entry
        {% if meta.date %} · {{ meta.date }}{% endif %}
        {% if meta.location %} · {{ meta.location }}{% endif %}
      </div>
      <span class="milestone">
        <span class="en">{{ narrative.milestone.en }}</span>
        <span class="ru">{{ narrative.milestone.ru }}</span>
        <span class="de">{{ narrative.milestone.de }}</span>
      </span>
      <h1>
        <span class="en">{{ narrative.title.en }}</span>
        <span class="ru">{{ narrative.title.ru }}</span>
        <span class="de">{{ narrative.title.de }}</span>
      </h1>
      <p class="subtitle">
        <span class="en">{{ narrative.subtitle.en }}</span>
        <span class="ru">{{ narrative.subtitle.ru }}</span>
        <span class="de">{{ narrative.subtitle.de }}</span>
      </p>
    </header>

    <ul class="stats" aria-label="hike stats">
      <li><span class="l">distance</span><span class="v">{{ stats.distance_km }} km</span></li>
      <li><span class="l">elev. gain</span><span class="v">{{ stats.elevation_gain_m | int }} m</span></li>
      <li><span class="l">duration</span><span class="v">{{ stats.duration_min }} min</span></li>
      <li><span class="l">summit</span><span class="v">{{ stats.summit_elev_m | int }} m</span></li>
    </ul>

    <svg class="elevation" viewBox="0 0 100 30" preserveAspectRatio="none" aria-hidden="true">
      <path d="M 0,30
        {%- for x, y in elevation %} L {{ (x * 100) | round(2) }},{{ (30 - y * 25) | round(2) }}{% endfor -%}
         L 100,30"/>
    </svg>

    {# Reading tools — Notes (audit) toggle. Defaults to hidden so the
       log reads as plain prose; the author flips body.audit on to see
       the per-sentence provenance treatment. Same vocabulary as the
       editorial template so a creator's preference travels. #}
    <div class="article-tools" role="group" aria-label="Show writing notes">
      <button
        type="button"
        id="notesBtn"
        aria-pressed="false"
        aria-label="Show or hide per-sentence writing notes"
      >Notes</button>
    </div>

    <article>
      {# ADR-014 / Phase 4: sentence-level provenance.
         Each sentence becomes a <span data-prov> so the rendered HTML
         carries the grounding info. The log register hides the
         treatment by default — `body.audit` opts in (see the
         article-tools button above). Tooltips render via the custom
         ::after data-tip pattern, not the native title attribute. #}
      <div class="en">
        {% for paragraph in narrative.paragraphs %}
          <p>
            {% for sentence in paragraph -%}
              <span class="sent" data-prov="{{ sentence.provenance.source }}" data-tip="{{ sentence.provenance.source }}: {{ sentence.provenance.reference }}">{{ sentence.text.en }}</span>{% if not loop.last %} {% endif -%}
            {% endfor %}
          </p>
        {% endfor %}
      </div>
      <div class="ru">
        {% for paragraph in narrative.paragraphs %}
          <p>
            {% for sentence in paragraph -%}
              <span class="sent" data-prov="{{ sentence.provenance.source }}" data-tip="{{ sentence.provenance.source }}: {{ sentence.provenance.reference }}">{{ sentence.text.ru }}</span>{% if not loop.last %} {% endif -%}
            {% endfor %}
          </p>
        {% endfor %}
      </div>
      <div class="de">
        {% for paragraph in narrative.paragraphs %}
          <p>
            {% for sentence in paragraph -%}
              <span class="sent" data-prov="{{ sentence.provenance.source }}" data-tip="{{ sentence.provenance.source }}: {{ sentence.provenance.reference }}">{{ sentence.text.de }}</span>{% if not loop.last %} {% endif -%}
            {% endfor %}
          </p>
        {% endfor %}
      </div>

      <blockquote>
        <span class="en">{{ narrative.pull_quote.en }}</span>
        <span class="ru">{{ narrative.pull_quote.ru }}</span>
        <span class="de">{{ narrative.pull_quote.de }}</span>
      </blockquote>
    </article>

    <section class="photos">
      {% for photo in photos %}
      <figure>
        <img src="{{ photo.data_uri }}" alt="" loading="lazy">
        <figcaption>frame {{ "%02d" | format(loop.index) }} / {{ photos | length }}</figcaption>
      </figure>
      {% endfor %}
    </section>

    <section class="share" aria-label="share">
      <a id="waLink" href="#" target="_blank" rel="noopener noreferrer">WhatsApp</a>
      <button id="copyBtn" type="button">Copy text</button>
      <button id="igBtn" type="button" data-slug="{{ meta.slug }}">Save for Instagram</button>
      <p id="igStatus" class="ig-status" aria-live="polite"></p>
    </section>

    <footer>{{ meta.slug }}</footer>
  </main>

  <style>
    .ig-status {
      font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
      font-size: 0.7rem;
      color: #57606a;
      margin-top: 0.45rem;
      min-height: 1.2em;
      letter-spacing: 0.04em;
    }
    .ig-fallback { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.5rem; }
    .ig-fallback a {
      display: inline-block;
      padding: 0.3rem 0.6rem;
      border: 1px solid #d0d7de;
      background: #ffffff;
      color: #1f2328 !important;
      text-decoration: none;
      border-radius: 3px;
      font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
      font-size: 0.7rem;
      letter-spacing: 0.04em;
    }
  </style>

  <script>
    (function () {
      var langs = ['en', 'ru', 'de'];
      var labels = { en: 'EN · RU · DE', ru: 'RU · DE · EN', de: 'DE · EN · RU' };
      var btn = document.getElementById('langBtn');

      function currentLang() {
        for (var i = 0; i < langs.length; i++) {
          if (document.body.classList.contains('lang-' + langs[i])) return langs[i];
        }
        return 'en';
      }

      function setLang(next) {
        for (var i = 0; i < langs.length; i++) {
          document.body.classList.remove('lang-' + langs[i]);
        }
        document.body.classList.add('lang-' + next);
        document.documentElement.lang = next;
        btn.textContent = labels[next];
      }

      btn.addEventListener('click', function () {
        var idx = langs.indexOf(currentLang());
        setLang(langs[(idx + 1) % langs.length]);
      });

      // ── Notes (audit) toggle (ADR-014 sentence-level provenance) ──
      // Mirrors the editorial template's toggle vocabulary so a creator
      // who flips notes on in one style sees the audit UI everywhere.
      // Preference persists in localStorage.
      var NOTES_KEY = 'trailstory.notes';
      var notesBtn = document.getElementById('notesBtn');
      function setNotes(on) {
        document.body.classList.toggle('audit', !!on);
        if (notesBtn) notesBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
        try { localStorage.setItem(NOTES_KEY, on ? '1' : '0'); } catch (e) {}
      }
      if (notesBtn) {
        var notesStored = null;
        try { notesStored = localStorage.getItem(NOTES_KEY); } catch (e) {}
        if (notesStored === '1') setNotes(true);
        notesBtn.addEventListener('click', function () {
          setNotes(!document.body.classList.contains('audit'));
        });
      }

      var titleEn = {{ narrative.title.en | tojson }};
      var quoteEn = {{ narrative.pull_quote.en | tojson }};
      var msg = titleEn + ' — ' + quoteEn;

      document.getElementById('waLink').href =
        'https://wa.me/?text=' + encodeURIComponent(msg);

      document.getElementById('copyBtn').addEventListener('click', function () {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(msg);
        }
      });

      // ── Instagram carousel ────────────────────────────────────────
      var igBtn = document.getElementById('igBtn');
      var igStatus = document.getElementById('igStatus');
      var slug = igBtn.getAttribute('data-slug');

      function setStatus(text) { igStatus.textContent = text || ''; }

      async function fetchSlideAsFile(url) {
        var res = await fetch(url);
        if (!res.ok) throw new Error('failed to fetch ' + url);
        var blob = await res.blob();
        var name = url.split('/').pop() || 'slide.jpg';
        return new File([blob], name, { type: blob.type || 'image/jpeg' });
      }

      function showFallbackLinks(urls) {
        var existing = document.getElementById('igFallback');
        if (existing) existing.remove();
        var box = document.createElement('div');
        box.id = 'igFallback';
        box.className = 'ig-fallback';
        urls.forEach(function (u, i) {
          var a = document.createElement('a');
          a.href = u;
          a.textContent = 'slide ' + (i + 1);
          a.setAttribute('download', '');
          box.appendChild(a);
        });
        igStatus.parentNode.insertBefore(box, igStatus.nextSibling);
      }

      async function saveForInstagram() {
        igBtn.disabled = true;
        setStatus('Building carousel…');
        try {
          var manifestRes = await fetch('/memory/' + slug + '/carousel', { method: 'POST' });
          if (!manifestRes.ok) throw new Error('carousel build failed (' + manifestRes.status + ')');
          var manifest = await manifestRes.json();
          var urls = (manifest && manifest.slides) || [];
          if (!urls.length) throw new Error('no slides returned');

          if (navigator.canShare) {
            setStatus('Preparing share sheet…');
            var files = await Promise.all(urls.map(fetchSlideAsFile));
            var shareData = { files: files, title: titleEn, text: msg };
            if (navigator.canShare(shareData)) {
              try {
                await navigator.share(shareData);
                setStatus('Saved. Open Instagram and pick the slides from your library.');
                igBtn.disabled = false;
                return;
              } catch (err) {
                // User dismissed; fall through to download links.
              }
            }
          }

          setStatus('Carousel ready. Click each slide to download.');
          showFallbackLinks(urls);
        } catch (err) {
          setStatus('Could not build carousel: ' + (err && err.message ? err.message : 'unknown'));
        }
        igBtn.disabled = false;
      }

      igBtn.addEventListener('click', saveForInstagram);
    })();
  </script>
</body>
</html>

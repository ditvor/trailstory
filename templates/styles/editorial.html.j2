<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ narrative.title.en }}</title>
<style>
  /* ── Editorial design system ──────────────────────────────────────────
     Black ink on cream paper. One serif (system Charter / Iowan / Garamond
     fallback chain), one mono (system UI mono). No CDN — the whole page
     stays readable offline (ADR-001). Tri-lingual via class swap (ADR-005).

     Adapted from the Trailpath / Claude Design "Letter" layout: editorial
     long-form essay, drop cap, asymmetric photo placement, pull quote
     with single left rule, marginalia stats column on desktop.
  */

  :root {
    --paper:   oklch(0.972 0.008 80);
    --paper-2: oklch(0.945 0.012 80);
    --ink:     oklch(0.18 0.01 80);
    --ink-2:   oklch(0.32 0.01 80);
    --ink-3:   oklch(0.55 0.01 80);
    --rule:     oklch(0.18 0.01 80 / 0.18);
    --hairline: oklch(0.18 0.01 80 / 0.10);

    --serif: 'Charter', 'Iowan Old Style', 'Apple Garamond', 'Hoefler Text',
             'Times New Roman', Georgia, serif;
    --mono: ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, Consolas, monospace;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --paper:   oklch(0.16 0.005 80);
      --paper-2: oklch(0.20 0.008 80);
      --ink:     oklch(0.94 0.005 80);
      --ink-2:   oklch(0.78 0.005 80);
      --ink-3:   oklch(0.58 0.005 80);
      --rule:     oklch(0.94 0.005 80 / 0.20);
      --hairline: oklch(0.94 0.005 80 / 0.10);
    }
  }

  *, *::before, *::after { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--serif);
    line-height: 1.55;
    font-feature-settings: "liga" 1, "kern" 1, "onum" 1;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  /* tri-lingual swap — body class chooses which language is shown */
  body.lang-en .ru, body.lang-en .de { display: none; }
  body.lang-ru .en, body.lang-ru .de { display: none; }
  body.lang-de .en, body.lang-de .ru { display: none; }

  main {
    max-width: 1080px;
    margin: 0 auto;
    padding: 4rem 1.25rem 3rem;
  }
  @media (min-width: 700px) { main { padding: 5rem 2rem 4rem; } }

  /* ── Typography primitives ──────────────────────────────────────────── */
  .eyebrow {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 0.6875rem;        /* 11px */
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .meta {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--ink-2);
  }
  .prose {
    font-family: var(--serif);
    font-size: 1.0625rem;        /* 17px */
    line-height: 1.6;
    color: var(--ink);
    text-wrap: pretty;
    hyphens: auto;
    -webkit-hyphens: auto;
  }
  .prose p { margin: 0 0 0.9em; }
  .prose p + p { margin-top: 0.9em; }

  /* drop cap on the first paragraph (the active language's first
     visible character takes the cap automatically — siblings in other
     languages are display:none and contribute nothing to ::first-letter) */
  p.drop::first-letter {
    font-weight: 600;
    font-size: 4.4em;
    line-height: 0.9;
    float: left;
    margin: 0.05em 0.08em 0 0;
    font-family: var(--serif);
    color: var(--ink);
  }

  /* ── Lang toggle ────────────────────────────────────────────────────── */
  .lang-toggle {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 10;
    display: inline-flex;
    border: 1px solid var(--ink);
    background: var(--paper);
    box-shadow: 0 1px 0 var(--hairline);
  }
  .lang-toggle button {
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border: 0;
    background: transparent;
    color: var(--ink);
    padding: 0.45rem 0.8rem;
    cursor: pointer;
  }
  .lang-toggle button[aria-pressed="true"] {
    background: var(--ink);
    color: var(--paper);
  }
  .lang-toggle button + button { border-left: 1px solid var(--ink); }

  /* ── Masthead ───────────────────────────────────────────────────────── */
  header.masthead { border-bottom: 1px solid var(--rule); padding-bottom: 1.75rem; }
  header.masthead .kicker { display: inline-block; }
  h1.title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2.5rem, 7vw, 4.75rem);
    line-height: 0.96;
    letter-spacing: -0.02em;
    margin: 1rem 0 0.6rem;
  }
  .dek {
    max-width: 36rem;
    font-size: clamp(1.0625rem, 2.4vw, 1.25rem);
    line-height: 1.45;
    color: var(--ink-2);
    margin: 0.5rem 0 0.85rem;
    text-wrap: balance;
  }
  .byline {
    margin: 0;
    color: var(--ink-3);
  }
  .byline-sep::before { content: " · "; color: var(--ink-3); padding: 0 0.15em; }

  /* ── Hero photo (first selected photo, cinematic crop) ──────────────── */
  .hero-photo {
    width: 100%;
    aspect-ratio: 16 / 9;
    margin: 2rem 0 0;
    overflow: hidden;
    background: var(--paper-2);
    border: 1px solid var(--hairline);
  }
  .hero-photo img {
    width: 100%; height: 100%; display: block;
    object-fit: cover; object-position: 50% 50%;
    filter: saturate(0.92) contrast(1.02);
  }
  @media (min-width: 900px) {
    .hero-photo { aspect-ratio: 2.35 / 1; }
  }

  /* ── Two-column body: article + marginalia sidebar ──────────────────── */
  .body-grid {
    display: grid;
    gap: 2.5rem;
    margin-top: 2.75rem;
  }
  @media (min-width: 900px) {
    .body-grid {
      grid-template-columns: 1fr 240px;
      gap: 3.5rem;
    }
  }

  article { min-width: 0; }

  /* asymmetric inline photo (only floats at desktop where the article
     column is wide enough; at mobile it's full-bleed in the flow) */
  .inline-photo {
    margin: 1.25rem 0;
    overflow: hidden;
    background: var(--paper-2);
    border: 1px solid var(--hairline);
  }
  .inline-photo img {
    width: 100%; height: auto; display: block;
    filter: saturate(0.92) contrast(1.02);
  }
  .inline-photo figcaption {
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: var(--ink-2);
    margin-top: 0.5rem;
    padding: 0 0.25rem;
  }
  @media (min-width: 900px) {
    .inline-photo--right {
      float: right;
      width: 240px;
      margin: 0.4rem 0 1rem 1.5rem;
      shape-outside: margin-box;
    }
    .inline-photo--left {
      float: left;
      width: 220px;
      margin: 0.4rem 1.5rem 1rem 0;
      shape-outside: margin-box;
    }
  }

  /* ── Pull quote ─────────────────────────────────────────────────────── */
  blockquote.pull {
    margin: 2.25rem 0 0.5rem;
    padding: 0 0 0 1.25rem;
    border-left: 2px solid var(--ink);
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    line-height: 1.3;
    color: var(--ink);
    text-wrap: pretty;
  }
  blockquote.pull::before { content: "“"; }
  blockquote.pull::after  { content: "”"; }

  /* ── Marginalia (sidebar) ───────────────────────────────────────────── */
  aside.marginalia { min-width: 0; }
  @media (min-width: 900px) {
    aside.marginalia .sticky { position: sticky; top: 1.5rem; }
  }
  aside.marginalia .eyebrow + dl { margin: 0.6rem 0 0; }
  aside.marginalia dl {
    font-family: var(--mono);
    font-size: 0.6875rem;
    line-height: 1.7;
    margin: 0;
  }
  aside.marginalia dl > div {
    display: grid;
    grid-template-columns: 5.25rem 1fr;
    gap: 0.5rem;
    padding: 0.32rem 0;
    border-bottom: 1px solid var(--hairline);
  }
  aside.marginalia dt {
    color: var(--ink-3);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
  }
  aside.marginalia dd { margin: 0; color: var(--ink); }
  aside.marginalia .sparkline-wrap {
    margin-top: 1.5rem;
  }
  aside.marginalia .sparkline-wrap svg {
    display: block;
    width: 100%;
    height: 38px;
    border: 1px solid var(--hairline);
    background: var(--paper-2);
    padding: 4px;
  }

  /* ── Photo scrapbook (remaining photos after the inline ones) ───────── */
  section.scrapbook {
    margin: 3rem 0 0;
    display: grid;
    gap: 0.6rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) {
    /* asymmetric 12-col grid; each photo claims a span via :nth-child */
    section.scrapbook {
      grid-template-columns: repeat(12, 1fr);
      gap: 0.75rem;
    }
    section.scrapbook figure { margin: 0; min-width: 0; }
    section.scrapbook figure:nth-child(4n + 1) { grid-column: span 7; }
    section.scrapbook figure:nth-child(4n + 2) { grid-column: span 5; }
    section.scrapbook figure:nth-child(4n + 3) { grid-column: span 5; }
    section.scrapbook figure:nth-child(4n + 4) { grid-column: span 7; }
  }
  section.scrapbook figure {
    margin: 0;
    overflow: hidden;
    background: var(--paper-2);
    border: 1px solid var(--hairline);
  }
  section.scrapbook img {
    width: 100%; height: 100%; display: block;
    object-fit: cover;
    aspect-ratio: 4 / 5;
    filter: saturate(0.92) contrast(1.02);
  }
  @media (min-width: 700px) {
    section.scrapbook figure:nth-child(4n + 1) img,
    section.scrapbook figure:nth-child(4n + 4) img { aspect-ratio: 3 / 2; }
  }

  /* ── Share row ──────────────────────────────────────────────────────── */
  section.share {
    margin: 3rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  section.share .share-label { margin-right: 0.4rem; }
  .btn {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    background: var(--ink);
    color: var(--paper);
    border: 0;
    padding: 0.65rem 0.9rem;
    text-decoration: none;
    cursor: pointer;
    transition: opacity 0.15s, transform 0.15s;
  }
  .btn:hover { opacity: 0.85; }
  .btn:active { transform: translateY(1px); }
  .btn--ghost {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--ink);
  }
  .btn--ghost:hover { background: var(--ink); color: var(--paper); opacity: 1; }
  .ig-status {
    width: 100%;
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: var(--ink-3);
    margin-top: 0.5rem;
    min-height: 1em;
  }
  .ig-fallback {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }
  .ig-fallback a {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--hairline);
    background: var(--paper-2);
  }

  footer.colophon {
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--hairline);
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /* respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .btn { transition: none; }
  }
</style>
</head>
<body class="lang-en style-editorial">

  <div class="lang-toggle" role="group" aria-label="Language">
    <button type="button" data-lang="en" aria-pressed="true">EN</button>
    <button type="button" data-lang="ru" aria-pressed="false">RU</button>
    <button type="button" data-lang="de" aria-pressed="false">DE</button>
  </div>

  <main>

    <header class="masthead">
      <span class="eyebrow kicker">
        <span class="en">{{ narrative.milestone.en }}</span>
        <span class="ru">{{ narrative.milestone.ru }}</span>
        <span class="de">{{ narrative.milestone.de }}</span>
      </span>
      <h1 class="title">
        <span class="en">{{ narrative.title.en }}</span>
        <span class="ru">{{ narrative.title.ru }}</span>
        <span class="de">{{ narrative.title.de }}</span>
      </h1>
      <p class="dek prose">
        <span class="en">{{ narrative.subtitle.en }}</span>
        <span class="ru">{{ narrative.subtitle.ru }}</span>
        <span class="de">{{ narrative.subtitle.de }}</span>
      </p>
      <p class="meta byline">
        <span class="en">From a recorded path, photographs, and a few sentences.</span>
        <span class="ru">Из записанного трека, фотографий и нескольких предложений.</span>
        <span class="de">Aus einem aufgezeichneten Pfad, Fotografien und ein paar Sätzen.</span>
        {% if meta.location or meta.date %}
        <span class="byline-sep"></span>
        {% if meta.location %}{{ meta.location }}{% endif %}
        {% if meta.location and meta.date %} · {% endif %}
        {% if meta.date %}{{ meta.date }}{% endif %}
        {% endif %}
      </p>
    </header>

    {% if photos|length > 0 %}
    <div class="hero-photo">
      <img src="{{ photos[0].data_uri }}" alt="">
    </div>
    {% endif %}

    <div class="body-grid">

      <article>
        {#
           Each paragraph is rendered ONCE — the three language variants
           live as inline <span> siblings inside the same <p>. CSS
           visibility on body.lang-* drives which one shows. Inline
           photos and the pull quote sit OUTSIDE the language spans so
           every photo embeds exactly once (data:URI economy + ADR-001
           bundle-size discipline).

           Photo placement rules: photos[1] becomes the inline-right
           figure after paragraph 0 if there are ≥ 2 paragraphs; photos[2]
           becomes inline-left after paragraph 1 if ≥ 3 paragraphs. Any
           photo that doesn't find an inline home falls through to the
           scrapbook below — no photo is dropped.
        #}
        {% set para_count = narrative.paragraphs.en | length %}
        {% set has_inline_right = photos | length > 1 and para_count >= 2 %}
        {% set has_inline_left  = photos | length > 2 and para_count >= 3 %}
        {% for i in range(para_count) %}
          {% if i == 1 and has_inline_right %}
          <figure class="inline-photo inline-photo--right">
            <img src="{{ photos[1].data_uri }}" alt="">
          </figure>
          {% endif %}

          <p class="prose{% if i == 0 %} drop{% endif %}">
            <span class="en">{{ narrative.paragraphs.en[i] }}</span>
            <span class="ru">{{ narrative.paragraphs.ru[i] }}</span>
            <span class="de">{{ narrative.paragraphs.de[i] }}</span>
          </p>

          {% if i == 1 %}
          <blockquote class="pull">
            <span class="en">{{ narrative.pull_quote.en }}</span>
            <span class="ru">{{ narrative.pull_quote.ru }}</span>
            <span class="de">{{ narrative.pull_quote.de }}</span>
          </blockquote>
          {% endif %}

          {% if i == 2 and has_inline_left %}
          <figure class="inline-photo inline-photo--left">
            <img src="{{ photos[2].data_uri }}" alt="">
          </figure>
          {% endif %}
        {% endfor %}
      </article>

      <aside class="marginalia">
        <div class="sticky">
          <div class="eyebrow">
            <span class="en">The facts</span>
            <span class="ru">Факты</span>
            <span class="de">Fakten</span>
          </div>
          <dl>
            {% if meta.location %}
            <div>
              <dt>
                <span class="en">Where</span>
                <span class="ru">Где</span>
                <span class="de">Wo</span>
              </dt>
              <dd>{{ meta.location }}</dd>
            </div>
            {% endif %}
            {% if meta.date %}
            <div>
              <dt>
                <span class="en">When</span>
                <span class="ru">Когда</span>
                <span class="de">Wann</span>
              </dt>
              <dd>{{ meta.date }}</dd>
            </div>
            {% endif %}
            <div>
              <dt>
                <span class="en">Distance</span>
                <span class="ru">Дистанция</span>
                <span class="de">Distanz</span>
              </dt>
              <dd>{{ stats.distance_km }} km</dd>
            </div>
            <div>
              <dt>
                <span class="en">Ascent</span>
                <span class="ru">Подъём</span>
                <span class="de">Anstieg</span>
              </dt>
              <dd>{{ stats.elevation_gain_m | int }} m</dd>
            </div>
            <div>
              <dt>
                <span class="en">Time</span>
                <span class="ru">Время</span>
                <span class="de">Dauer</span>
              </dt>
              <dd>{{ stats.duration_min }} min</dd>
            </div>
            <div>
              <dt>
                <span class="en">Summit</span>
                <span class="ru">Вершина</span>
                <span class="de">Gipfel</span>
              </dt>
              <dd>{{ stats.summit_elev_m | int }} m</dd>
            </div>
          </dl>

          <div class="sparkline-wrap">
            <div class="eyebrow">
              <span class="en">Elevation</span>
              <span class="ru">Высота</span>
              <span class="de">Höhe</span>
            </div>
            <svg class="elevation" viewBox="0 0 100 30" preserveAspectRatio="none" aria-hidden="true">
              <path d="M 0,30
                {%- for x, y in elevation %} L {{ (x * 100) | round(2) }},{{ (30 - y * 25) | round(2) }}{% endfor -%}
                 L 100,30 Z"
                fill="oklch(0.18 0.01 80 / 0.10)"
                stroke="none"/>
              <path d="M 0,30
                {%- for x, y in elevation %} L {{ (x * 100) | round(2) }},{{ (30 - y * 25) | round(2) }}{% endfor %}"
                fill="none"
                stroke="var(--ink)"
                stroke-width="0.7"/>
            </svg>
          </div>
        </div>
      </aside>

    </div>

    {#
       Scrapbook: every photo that wasn't claimed by hero (photos[0]) or
       the inline placements above. photos[1] and photos[2] fall through
       here when the narrative is short enough to leave them homeless;
       photos[3:] always falls through.
    #}
    {% set has_orphan_right = photos | length > 1 and not has_inline_right %}
    {% set has_orphan_left  = photos | length > 2 and not has_inline_left %}
    {% set has_tail = photos | length > 3 %}
    {% if has_orphan_right or has_orphan_left or has_tail %}
    <section class="scrapbook" aria-label="photographs">
      {% if has_orphan_right %}
      <figure>
        <img src="{{ photos[1].data_uri }}" alt="" loading="lazy">
      </figure>
      {% endif %}
      {% if has_orphan_left %}
      <figure>
        <img src="{{ photos[2].data_uri }}" alt="" loading="lazy">
      </figure>
      {% endif %}
      {% if has_tail %}
        {% for photo in photos[3:] %}
        <figure>
          <img src="{{ photo.data_uri }}" alt="" loading="lazy">
        </figure>
        {% endfor %}
      {% endif %}
    </section>
    {% endif %}

    <section class="share" aria-label="share">
      <span class="eyebrow share-label">
        <span class="en">Share →</span>
        <span class="ru">Поделиться →</span>
        <span class="de">Teilen →</span>
      </span>
      <a id="waLink" class="btn" href="#" target="_blank" rel="noopener noreferrer">WhatsApp</a>
      <button id="copyBtn" class="btn btn--ghost" type="button">
        <span class="en">Copy text</span>
        <span class="ru">Копировать</span>
        <span class="de">Kopieren</span>
      </button>
      <button id="igBtn" class="btn btn--ghost" type="button" data-slug="{{ meta.slug }}">
        <span class="en">Save for Instagram</span>
        <span class="ru">Сохранить для Instagram</span>
        <span class="de">Für Instagram speichern</span>
      </button>
      <p id="igStatus" class="ig-status" aria-live="polite"></p>
    </section>

    <footer class="colophon">{{ meta.slug }}</footer>
  </main>

  <script>
    (function () {
      var langs = ['en', 'ru', 'de'];
      var buttons = document.querySelectorAll('.lang-toggle button');

      function setLang(next) {
        for (var i = 0; i < langs.length; i++) {
          document.body.classList.remove('lang-' + langs[i]);
        }
        document.body.classList.add('lang-' + next);
        document.documentElement.lang = next;
        buttons.forEach(function (b) {
          b.setAttribute('aria-pressed', b.getAttribute('data-lang') === next ? 'true' : 'false');
        });
      }

      buttons.forEach(function (b) {
        b.addEventListener('click', function () {
          setLang(b.getAttribute('data-lang'));
        });
      });

      var titleEn = {{ narrative.title.en | tojson }};
      var quoteEn = {{ narrative.pull_quote.en | tojson }};
      var msg = titleEn + ' — ' + quoteEn;

      document.getElementById('waLink').href =
        'https://wa.me/?text=' + encodeURIComponent(msg);

      document.getElementById('copyBtn').addEventListener('click', function () {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(msg);
        }
      });

      // ── Instagram carousel ────────────────────────────────────────
      var igBtn = document.getElementById('igBtn');
      var igStatus = document.getElementById('igStatus');
      var slug = igBtn.getAttribute('data-slug');

      function setStatus(text) { igStatus.textContent = text || ''; }

      async function fetchSlideAsFile(url) {
        var res = await fetch(url);
        if (!res.ok) throw new Error('failed to fetch ' + url);
        var blob = await res.blob();
        var name = url.split('/').pop() || 'slide.jpg';
        return new File([blob], name, { type: blob.type || 'image/jpeg' });
      }

      function showFallbackLinks(urls) {
        var existing = document.getElementById('igFallback');
        if (existing) existing.remove();
        var box = document.createElement('div');
        box.id = 'igFallback';
        box.className = 'ig-fallback';
        urls.forEach(function (u, i) {
          var a = document.createElement('a');
          a.href = u;
          a.textContent = 'Slide ' + (i + 1);
          a.setAttribute('download', '');
          box.appendChild(a);
        });
        igStatus.parentNode.insertBefore(box, igStatus.nextSibling);
      }

      async function saveForInstagram() {
        igBtn.disabled = true;
        setStatus('Building carousel…');
        try {
          var manifestRes = await fetch('/memory/' + slug + '/carousel', { method: 'POST' });
          if (!manifestRes.ok) throw new Error('carousel build failed (' + manifestRes.status + ')');
          var manifest = await manifestRes.json();
          var urls = (manifest && manifest.slides) || [];
          if (!urls.length) throw new Error('no slides returned');

          if (navigator.canShare) {
            setStatus('Preparing share sheet…');
            var files = await Promise.all(urls.map(fetchSlideAsFile));
            var shareData = { files: files, title: titleEn, text: msg };
            if (navigator.canShare(shareData)) {
              try {
                await navigator.share(shareData);
                setStatus('Saved. Open Instagram and pick the slides from your library.');
                igBtn.disabled = false;
                return;
              } catch (err) {
                // User dismissed the share sheet — that's fine, fall through.
              }
            }
          }

          setStatus('Carousel ready. Click each slide to download.');
          showFallbackLinks(urls);
        } catch (err) {
          setStatus('Could not build carousel: ' + (err && err.message ? err.message : 'unknown'));
        }
        igBtn.disabled = false;
      }

      igBtn.addEventListener('click', saveForInstagram);
    })();
  </script>
</body>
</html>

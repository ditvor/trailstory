<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ narrative.title_en }}</title>
<style>
  *, *::before, *::after { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    font-family: ui-serif, Georgia, "Times New Roman", serif;
    color: #1a1a1a;
    background: #faf8f4;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  main { max-width: 720px; margin: 0 auto; padding: 2.5rem 1.25rem 4rem; }

  /* hero */
  header.hero { text-align: center; margin-bottom: 2rem; }
  .milestone {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border: 1px solid #c8b88a;
    border-radius: 999px;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6b5a2c;
    background: #fdf6e0;
    margin-bottom: 1rem;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0 0 0.5rem;
    line-height: 1.15;
    font-weight: 700;
  }
  .meta { font-size: 0.9rem; color: #6c6c6c; }

  /* lang toggle */
  .lang-toggle { position: fixed; top: 0.75rem; right: 0.75rem; z-index: 10; }
  .lang-toggle button {
    background: #1a1a1a;
    color: #faf8f4;
    border: 0;
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }

  /* bilingual swap: default body shows EN; .lang-ru shows RU. */
  body.lang-ru .en { display: none; }
  body:not(.lang-ru) .ru { display: none; }

  /* stats */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
    padding: 1.25rem 0;
    margin: 2rem 0 1rem;
    border-top: 1px solid #e6dec8;
    border-bottom: 1px solid #e6dec8;
    text-align: center;
  }
  .stats .v { font-size: 1.4rem; font-weight: 600; }
  .stats .l {
    font-size: 0.7rem;
    color: #6c6c6c;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* elevation profile */
  .elevation {
    width: 100%;
    height: 110px;
    margin-bottom: 2rem;
    display: block;
  }
  .elevation path {
    fill: rgba(200, 184, 138, 0.35);
    stroke: #6b5a2c;
    stroke-width: 0.6;
    stroke-linejoin: round;
  }

  /* article */
  article p { font-size: 1.08rem; margin: 0 0 1.25rem; }
  blockquote {
    border-left: 3px solid #c8b88a;
    margin: 2rem 0;
    padding: 0.5rem 1.25rem;
    font-size: 1.2rem;
    font-style: italic;
    color: #4a4032;
  }

  /* photos */
  .photos {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin: 2.5rem 0;
  }
  @media (min-width: 540px) {
    .photos { grid-template-columns: 1fr 1fr; }
  }
  .photos img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 8px;
    box-shadow: 0 6px 20px rgba(0,0,0,0.08);
  }

  /* share */
  .share { text-align: center; margin: 3rem 0 1rem; }
  .share a, .share button {
    display: inline-block;
    margin: 0.25rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: #1a1a1a;
    color: #faf8f4;
    text-decoration: none;
    border: 0;
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
  }

  footer {
    text-align: center;
    color: #999;
    font-size: 0.75rem;
    margin-top: 2rem;
  }
</style>
</head>
<body>
  <div class="lang-toggle">
    <button id="langBtn" type="button" aria-label="Toggle language">RU / EN</button>
  </div>

  <main>
    <header class="hero">
      <span class="milestone">
        <span class="en">{{ narrative.milestone_en }}</span>
        <span class="ru">{{ narrative.milestone_ru }}</span>
      </span>
      <h1>
        <span class="en">{{ narrative.title_en }}</span>
        <span class="ru">{{ narrative.title_ru }}</span>
      </h1>
      {% if meta.location or meta.date %}
      <div class="meta">
        {% if meta.location %}{{ meta.location }}{% endif %}
        {% if meta.location and meta.date %} · {% endif %}
        {% if meta.date %}{{ meta.date }}{% endif %}
      </div>
      {% endif %}
    </header>

    <section class="stats" aria-label="hike stats">
      <div><div class="v">{{ stats.distance_km }}</div><div class="l">km</div></div>
      <div><div class="v">{{ stats.elevation_gain_m | int }}</div><div class="l">m gain</div></div>
      <div><div class="v">{{ stats.duration_min }}</div><div class="l">min</div></div>
      <div><div class="v">{{ stats.summit_elev_m | int }}</div><div class="l">m summit</div></div>
    </section>

    <svg class="elevation" viewBox="0 0 100 30" preserveAspectRatio="none" aria-hidden="true">
      <path d="M 0,30
        {%- for x, y in elevation %} L {{ (x * 100) | round(2) }},{{ (30 - y * 25) | round(2) }}{% endfor -%}
         L 100,30 Z"/>
    </svg>

    <article>
      <div class="en">
        {% for p in narrative.paragraphs_en %}<p>{{ p }}</p>{% endfor %}
      </div>
      <div class="ru">
        {% for p in narrative.paragraphs_ru %}<p>{{ p }}</p>{% endfor %}
      </div>

      <blockquote>
        <span class="en">{{ narrative.pull_quote_en }}</span>
        <span class="ru">{{ narrative.pull_quote_ru }}</span>
      </blockquote>
    </article>

    <section class="photos">
      {% for photo in photos %}
      <img src="{{ photo.data_uri }}" alt="" loading="lazy">
      {% endfor %}
    </section>

    <section class="share" aria-label="share">
      <a id="waLink" href="#" target="_blank" rel="noopener noreferrer">WhatsApp</a>
      <button id="copyBtn" type="button">Copy text</button>
    </section>

    <footer>{{ meta.slug }}</footer>
  </main>

  <script>
    (function () {
      var btn = document.getElementById('langBtn');
      btn.addEventListener('click', function () {
        document.body.classList.toggle('lang-ru');
        document.documentElement.lang =
          document.body.classList.contains('lang-ru') ? 'ru' : 'en';
      });

      var titleEn = {{ narrative.title_en | tojson }};
      var quoteEn = {{ narrative.pull_quote_en | tojson }};
      var msg = titleEn + ' — ' + quoteEn;

      document.getElementById('waLink').href =
        'https://wa.me/?text=' + encodeURIComponent(msg);

      document.getElementById('copyBtn').addEventListener('click', function () {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(msg);
        }
      });
    })();
  </script>
</body>
</html>
